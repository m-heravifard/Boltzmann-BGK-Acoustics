        ax.set_title(f"{r['display_name']}\nnorm. RMSE={r['rmse_u_normalized']:.3f}")
        ax.set_xlabel("x"); ax.grid(True); ax.legend(fontsize=7)
    for ax in axes_flat[:len(arch_configs)]:
        if ax.get_subplotspec().is_first_col():
            ax.set_ylabel(f"u(x,t={d_train['t'][it_show]:.3f})")
    for ax in axes_flat[len(arch_configs):]:
        ax.axis("off")
    plt.tight_layout()
    plt.savefig(f"{OUT}/forward_architecture_comparison.png", dpi=150)
    plt.close()

    summary = {
        "Kn_list": Kn_list,
        "damping_rates": damping_table,
        "spectral_ansatz_residuals": residual_table,
        "forward_pikan_Kn_train": Kn_train,
        "forward_modal_harmonics": H_train,
        "best_architecture": DISPLAY_NAMES[best_arch],
        "architecture_comparison": {
            DISPLAY_NAMES[k]: {kk: vv for kk, vv in v.items() if kk not in ("u_pred", "hist")}
            for k, v in arch_results.items()
        },
        "forward_pikan_rmse_u_eval": arch_results[best_arch]["rmse_u"],
        "forward_pikan_rel_err_normalized": arch_results[best_arch]["rmse_u_normalized"],
    }
    with open(f"{OUT}/forward_summary.json", "w") as f:
        json.dump(summary, f, indent=2)
    print("Forward study complete:", json.dumps(summary["architecture_comparison"], indent=2))


