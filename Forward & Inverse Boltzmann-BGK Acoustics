extract_v1 = extract_features_windowed
extract_v2 = extract_features_parametric

N_SENSORS = 3


def build_calibration_dataset_v2(Kn_values, extractor, regimes=("linear",), n_sensors=N_SENSORS,
                                  NX=64, Nvel=32, T_final=0.6, seed=0, n_sensor_draws=5):
    rng = np.random.default_rng(seed)
    X, Y, meta = [], [], []
    for regime, eps in [("linear", 1e-3), ("nonlinear", 3e-1)]:
        if regime not in regimes:
            continue
        for Kn in Kn_values:
            d = run_bgk_acoustic(Kn=Kn, eps=eps, NX=NX, Nvel=Nvel, T_final=T_final, CFL=0.4)
            NXg = len(d["x"])
            for draw in range(n_sensor_draws):
                idx = np.sort(rng.choice(np.arange(4, NXg - 4), size=n_sensors, replace=False))
                sens = sample_sensors(d, idx, field_names=("p", "u"))
                feats = extractor(sens["t"], sens)
                X.append(feats); Y.append(np.log10(Kn))
                meta.append({"regime": regime, "Kn": float(Kn), "draw": draw})
    return np.array(X), np.array(Y).reshape(-1, 1), meta


def evaluate(Xall, Yall, meta, arch, layer_sizes, kwargs, lr, epochs, wd, n_splits=4):
    all_true, all_pred = [], []
    for split_seed in range(n_splits):
        Xtr, is_test, keep, unique_Kn = held_out_split(Xall, meta, seed=split_seed)
        mu, sd = Xtr.mean(0, keepdims=True), Xtr.std(0, keepdims=True) + 1e-8
        Xtr_n = (Xtr - mu) / sd
        Ytr = Yall[~is_test]
        Xte, Yte = (Xall[keep] - mu) / sd, Yall[keep]
        key = random.PRNGKey(7 + split_seed)
        params, hist, apply_fn = fit_generic(arch, key, layer_sizes, Xtr_n, Ytr,
                                              lr=lr, epochs=epochs, weight_decay=wd, arch_kwargs=kwargs)
        pred = np.asarray(apply_fn(params, jnp.asarray(Xte)))
        all_true.append(10 ** Yte.squeeze())
        all_pred.append(10 ** pred.squeeze())
    true_arr = np.concatenate([np.atleast_1d(a) for a in all_true])
    pred_arr = np.concatenate([np.atleast_1d(a) for a in all_pred])
    err = np.abs(pred_arr - true_arr) / true_arr * 100
    return float(np.median(err)), float(np.max(err)), len(err)


def run_feature_comparison_main():
    which = sys.argv[1] if len(sys.argv) > 1 else "v2"
    Kn_calib = np.geomspace(3e-4, 3.0, 34)
    t0 = time.time()
    extractor = extract_v2 if which == "v2" else extract_v1
    Xall, Yall, meta = build_calibration_dataset_v2(Kn_calib, extractor, regimes=("linear",), n_sensor_draws=5)
    print(f"features={which}: dataset built {Xall.shape}, t={time.time()-t0:.1f}s")
    n_in = Xall.shape[1]

    results = {}
    for arch, layer_sizes, kwargs, lr, epochs in [
        ("siren", [n_in, 16, 1], dict(omega_0=1.0), 3e-3, 4000),
        ("mlp_pinn", [n_in, 16, 16, 1], dict(), 5e-3, 4000),
        ("chebykan", [n_in, 8, 1], dict(order=4), 5e-3, 4000),
    ]:
        med, mx, n = evaluate(Xall, Yall, meta, arch, layer_sizes, kwargs, lr, epochs, wd=1e-3)
        results[arch] = {"median_err_pct": med, "max_err_pct": mx, "n_test": n}
        print(f"  [{which}] {arch}: median={med:.2f}% max={mx:.1f}% n={n}  t={time.time()-t0:.1f}s")

    with open(f"outputs/feature_comparison_{which}.json", "w") as f:
        json.dump(results, f, indent=2)


def kinetic_self_test():
    """Physics identity and integration checks, not publication validation."""
    v,w=kinetic_quadrature(40); A,B=kinetic_projection(v,w,np)
    np.testing.assert_allclose(A@B,np.eye(3),atol=2e-14)
    # Deliberately anisotropic distribution: Pxx must differ from p.
    g=1/np.sqrt(4*np.pi)*np.exp(-v*v/4); h=2*g
    m=kinetic_moments(g,h,v,w,np)
    np.testing.assert_allclose(m['momentum_flux'],m['rho']*m['u']**2+m['Pxx'],atol=1e-12)
    assert abs(float(m['Pxx']-m['p']))>0.5
    ge,he=kinetic_equilibrium(g,h,v,w,A,B,np)
    np.testing.assert_allclose(A@np.concatenate([ge-g,he-h]),np.zeros(3),atol=2e-14)
    # Moment residuals must equal moments of the discrete BGK residual.
    vv,ww=jnp.asarray(v),jnp.asarray(w); aa,bb=kinetic_projection(vv,ww)
    par=siren_init(random.PRNGKey(8),[1,8,2*40*5],omega_0=30.)
    rb,rc,_=kinetic_point_residual(par,jnp.array([0.173,0.025]),vv,ww,aa,bb,
                                  0.02,8*np.pi,1e-3,0.1,2)
    weighted=jnp.array([jnp.sum(ww*rb[0]),jnp.sum(ww*vv*rb[0]),
                        0.5*jnp.sum(ww*(vv*vv*rb[0]+rb[1]))])
    np.testing.assert_allclose(rc,weighted,atol=2e-13)
    # Hard initial Maxwellian and periodicity.
    gh=kinetic_distribution(par,jnp.array([0.173,0.]),vv,8*np.pi,1e-3,0.1,2)
    mi=kinetic_moments(gh[0],gh[1],vv,ww)
    target=1+1e-3*np.sin(8*np.pi*0.173)
    np.testing.assert_allclose(mi['rho'],target,atol=1e-12)
    np.testing.assert_allclose(kinetic_distribution(par,jnp.array([0.,0.025]),vv,8*np.pi,1e-3,0.1,2),
                               kinetic_distribution(par,jnp.array([1.,0.025]),vv,8*np.pi,1e-3,0.1,2),atol=1e-14)
    # Solver splitting conservation, timestamp and stress checks across regimes.
    for kn in [3e-4,0.01,1.]:
        d=run_bgk_acoustic(kn,NX=24,Nvel=24,T_final=0.025)
        np.testing.assert_allclose(d['conserved_total_drift'],0,atol=2e-12)
        assert d['t'][0]==0 and abs(d['t'][-1]-0.025)<1e-14
        np.testing.assert_allclose(d['momentum_flux'],d['rho']*d['u']**2+d['Pxx'],atol=1e-12)
    # Consolidation regression: combined features must terminate with 14 values.
    t=np.linspace(0,1,100); y=np.exp(-2*t)*np.cos(12*t)
    features=extract_features_combined(t,{'p':(1+y[:,None]*1e-3),'u':y[:,None]*1e-3})
    assert features.shape==(14,) and np.all(np.isfinite(features))
    print('PASS: kinetic stress, collision conservation, moment residual identity, initial/periodic conditions, solver conservation/timestamps, 14-feature extraction.')


def _jsonable(value):
    if isinstance(value,dict): return {k:_jsonable(v) for k,v in value.items()}
    if isinstance(value,(list,tuple)): return [_jsonable(v) for v in value]
    if isinstance(value,np.ndarray): return value.tolist()
    if isinstance(value,np.generic): return value.item()
    return value


