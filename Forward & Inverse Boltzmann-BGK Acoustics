Kn_calib = np.geomspace(3e-4, 3.0, 34)
N_SENSORS = 3

# Observable hierarchy, from least to most information, and from most to
# least experimentally accessible (see paper Sec. 5.7 / accessibility
# tiers): {p,u} are the standard directly measurable acoustic quantities;
# {rho,T} require additional (still standard) diagnostics; q (heat flux) is
# a kinetic non-equilibrium moment not directly measurable by ordinary
# pressure/velocity transducers, included here as an upper bound on how
# much a full kinetic diagnostic could help.
LEVELS = {
    "gamma_only":        (("u",), "decay_only"),
    "gamma_omega":       (("u",), "decay_freq"),
    "p_u":               (("p", "u"), "combined"),
    "p_u_rho_T":         (("p", "u", "rho", "T"), "combined"),
    "p_u_rho_T_q":       (("p", "u", "rho", "T", "q"), "combined"),
}


def build_dataset(keys, feature_mode, Kn_values, n_sensor_draws=5, seed=0):
    rng = np.random.default_rng(seed)
    X, Y, meta = [], [], []
    for Kn in Kn_values:
        d = run_bgk_acoustic(Kn=Kn, eps=1e-3, NX=64, Nvel=32, T_final=0.6, CFL=0.4)
        NXg = len(d["x"])
        for draw in range(n_sensor_draws):
            idx = np.sort(rng.choice(np.arange(4, NXg - 4), size=N_SENSORS, replace=False))
            sens = sample_sensors(d, idx, field_names=keys)
            if feature_mode == "combined":
                feats = extract_features_combined(sens["t"], sens, keys=keys)
            elif feature_mode == "decay_freq":
                # gamma + omega only: parametric decay rate and frequency of u
                full = extract_features_parametric(sens["t"], sens, keys=keys)
                feats = full[1:3]  # [decay_u_param, freq_u_param]
            elif feature_mode == "decay_only":
                full = extract_features_parametric(sens["t"], sens, keys=keys)
                feats = full[1:2]  # [decay_u_param]
            X.append(feats); Y.append(np.log10(Kn)); meta.append({"Kn": float(Kn)})
    return np.array(X), np.array(Y).reshape(-1, 1), meta


def evaluate_level(level_name, n_splits=8, Kn_values=None, n_sensor_draws=5):
    Kn_values = Kn_calib if Kn_values is None else Kn_values
    keys, mode = LEVELS[level_name]
    Xall, Yall, meta = build_dataset(keys, mode, Kn_values, n_sensor_draws=n_sensor_draws)
    n_in = Xall.shape[1]
    Kn_true_all, Kn_pred_all = [], []
    for split_seed in range(n_splits):
        Xtr, is_test, keep, unique_Kn = held_out_split(Xall, meta, seed=split_seed)
        Ytr = Yall[~is_test]
        Xte, Yte = Xall[keep], Yall[keep]
        # widen the hidden layer modestly for the richer feature sets
        hidden = 16 if n_in <= 16 else 24
        net_inv, (mu, sd), hist, pred_test, _ = train_inverse_map(
            Xtr, Ytr, Xte, hidden=hidden, omega_0=1.0, epochs=4000, lr=3e-3, weight_decay=1e-3,
            seed=7 + split_seed)
        Kn_true_all.append(10 ** Yte.squeeze())
        Kn_pred_all.append(10 ** pred_test.squeeze())
    Kn_true = np.concatenate([np.atleast_1d(a) for a in Kn_true_all])
    Kn_pred = np.concatenate([np.atleast_1d(a) for a in Kn_pred_all])
    err = np.abs(Kn_pred - Kn_true) / Kn_true * 100
    acc, _ = classification_accuracy(Kn_true, Kn_pred)
    return {"level": level_name, "n_features": int(n_in), "n_train_examples": int(Xall.shape[0]),
            "median_err_pct": float(np.median(err)),
            "max_err_pct": float(np.max(err)), "classification_acc_pct": float(acc * 100),
            "n_test": len(err)}


def run_information_hierarchy_main():
    level = sys.argv[1]
    scale = sys.argv[2] if len(sys.argv) > 2 else "base"
    if scale == "base":
        Kn_values, n_draws, tag = Kn_calib, 5, "information_hierarchy"
    elif scale == "large":
        # ~3.5x more training examples: more Kn values AND more sensor draws
        Kn_values, n_draws, tag = np.geomspace(3e-4, 3.0, 50), 8, "information_hierarchy_large"
    else:
        raise ValueError(scale)
    r = evaluate_level(level, Kn_values=Kn_values, n_sensor_draws=n_draws)
    print(f"[{scale}] {level}: n_train={r['n_train_examples']} n_features={r['n_features']} "
          f"median={r['median_err_pct']:.2f}% max={r['max_err_pct']:.1f}% "
          f"class_acc={r['classification_acc_pct']:.1f}%")
    import os
    results = {}
    path = f"{OUT}/{tag}.json"
    if os.path.exists(path):
        with open(path) as f:
            results = json.load(f)
    results[level] = r
    with open(path, "w") as f:
        json.dump(results, f, indent=2)


