"""
Inverse regime identification for the Boltzmann-BGK equation. (JAX autodiff.)

Central novelty of the paper (see paper Sec. 5):

        {p(t), u(t)}_sparse sensors   ---->   {Kn, tau}

rather than PIKAN -> acoustic simulation (the forward direction studied
in Sec. 4 / run_forward.py).

Two networks are trained, both differentiated with JAX (jax.value_and_grad)
and optimized with optax.adam:

  (A) Inverse-map regressor  R_phi : features(p(t),u(t)) -> log10(Kn).
      A labeled calibration dataset is generated by running the DVM-BGK
      solver (bgk_acoustic.run_bgk_acoustic) across a wide range of
      Knudsen numbers, extracting the SAME sparse-sensor feature vector
      (envelope decay rate, amplitude ratio, dominant frequency -- see
      sensor_features.py) that would be available from a real point-probe
      experiment, and pairing it with the known Kn used to generate it.
      This mirrors instrument calibration: the forward kinetic solver
      plays the role of a controlled calibration experiment / digital
      twin. A dedicated architecture comparison for this sub-task
      (inverse_arch_comparison.py, 7 architectures, same held-out-Kn
      protocol as Sec. 4.3) is used to pick the regressor -- SEE
      train_inverse_map's docstring below for the verified result.

  (B) Kinetic reconstruction: a time-to-Fourier-coefficient SIREN
      represents positive reduced distributions g,h. Macroscopic fields,
      Pxx, and Pi_xx are velocity moments. BGK residuals constrain the stress;
      the momentum residual uses integral(v**2*g dv), never rho*u**2+p.
      tau is supplied as an independent estimate or fitted jointly.
      Reference stress and true Kn are excluded from the training API.
"""
import json, os, time
extract_features = extract_features_combined
FEATURE_NAMES = COMBINED_FEATURE_NAMES

OUT = "outputs"
os.makedirs(OUT, exist_ok=True)
RHO0, U0, T0 = 1.0, 0.0, 1.0
P0 = RHO0 * T0
N_SENSORS = 3


def regime_of_Kn(Kn):
    """Standard rarefied-gas-dynamics Knudsen-number regime classification
    (e.g. Cercignani 2000): continuum (Kn<0.01, Navier-Stokes/no-slip
    valid), slip flow (0.01<=Kn<0.1, Navier-Stokes with slip boundary
    conditions), transitional (0.1<=Kn<10, neither continuum nor
    free-molecular theory applies), free-molecular (Kn>=10, collisionless).
    Used to report regime-CLASSIFICATION accuracy alongside continuous-Kn
    regression error: for many practical purposes (e.g. deciding which
    solver/closure to trust) correctly identifying which of these four
    regimes a flow is in matters more than precisely resolving Kn to
    within a fraction of a decade."""
    if Kn < 1e-2:
        return "continuum"
    elif Kn < 1e-1:
        return "slip"
    elif Kn < 10:
        return "transitional"
    else:
        return "free-molecular"


REGIME_ORDER = ["continuum", "slip", "transitional", "free-molecular"]


def classification_accuracy(Kn_true, Kn_pred):
    """Fraction of held-out points for which the identified Kn falls in the
    SAME regime bin as the true Kn (regardless of precise numerical error
    within that bin), plus a confusion matrix over REGIME_ORDER."""
    true_labels = [regime_of_Kn(k) for k in Kn_true]
    pred_labels = [regime_of_Kn(k) for k in Kn_pred]
    correct = sum(t == p for t, p in zip(true_labels, pred_labels))
    acc = correct / len(true_labels)
    conf = {t: {p: 0 for p in REGIME_ORDER} for t in REGIME_ORDER}
    for t, p in zip(true_labels, pred_labels):
        conf[t][p] += 1
    return acc, conf


def build_calibration_dataset(Kn_values, regimes=("linear", "nonlinear"), n_sensors=N_SENSORS,
                               NX=64, Nvel=32, T_final=0.6, seed=0, n_sensor_draws=3, snr_db=None):
    """For each Kn, run the DVM-BGK solver ONCE and draw several independent
    random sparse-sensor placements from the resulting field (data
    augmentation over sensor location, cheap since it reuses the same
    simulation).

    snr_db: if not None, adds i.i.d. Gaussian noise to each sensor's p(t)
    and u(t) time series independently, at the given signal-to-noise ratio
    in dB (SNR = 10*log10(signal_power/noise_power), signal_power estimated
    per-sensor from that sensor's own RMS) BEFORE feature extraction --
    i.e. noise is applied at the level of the raw synthetic measurement, not
    to the extracted features, matching how sensor noise would actually
    enter a real experiment."""
    rng = np.random.default_rng(seed)
    X, Y, meta = [], [], []
    for regime, eps in [("linear", 1e-3), ("nonlinear", 3e-1)]:
        if regime not in regimes:
            continue
        for Kn in Kn_values:
            d = run_bgk_acoustic(Kn=Kn, eps=eps, NX=NX, Nvel=Nvel, T_final=T_final, CFL=0.4)
            NXg = len(d["x"])
            for draw in range(n_sensor_draws):
                idx = np.sort(rng.choice(np.arange(4, NXg - 4), size=n_sensors, replace=False))
                sens = sample_sensors(d, idx, field_names=("p", "u"))
                if snr_db is not None:
                    sens = {"t": sens["t"], "x_sensor": sens["x_sensor"],
                            **_add_sensor_noise(sens, snr_db, rng)}
                feats = extract_features(sens["t"], sens)
                X.append(feats); Y.append(np.log10(Kn))
                meta.append({"regime": regime, "Kn": float(Kn), "draw": draw})
    return np.array(X), np.array(Y).reshape(-1, 1), meta


def _add_sensor_noise(sens, snr_db, rng):
    """Add i.i.d. Gaussian noise to each sensor column of p and u
    independently at the specified SNR (dB), estimating signal power from
    that column's own variance (noise added around the mean-subtracted
    signal, consistent with how sensor_features itself treats the mean)."""
    out = {}
    snr_lin = 10 ** (snr_db / 10.0)
    for key in ("p", "u"):
        x = sens[key]
        x_centered = x - x.mean(axis=0, keepdims=True)
        sig_power = np.mean(x_centered ** 2, axis=0, keepdims=True) + 1e-30
        noise_power = sig_power / snr_lin
        noise = rng.normal(0, 1, x.shape) * np.sqrt(noise_power)
        out[key] = x + noise
    return out


def train_inverse_map(Xtr, Ytr, Xte, hidden=16, omega_0=1.0, epochs=4000, lr=3e-3, seed=7,
                       weight_decay=1e-3):
    """Sec. 5.2(C) scalar inverse-map regressor: sparse-sensor feature vector
    -> log10(Kn). Uses SIREN. This choice went through two rounds of
    empirical testing (inverse_arch_comparison.py), plus a preprocessing
    bug found and fixed along the way (see below).

    Round 1 (crude windowed-RMS features, 4 pooled held-out-Kn splits):
        tanh-MLP (PINN)   13.1%  (max 310%)
        SIREN             14.7%  (max 89%)      <- chosen (best max)
        Chebyshev-KAN     17.6%  (max 3120%)
        B-spline KAN      19.2%  (max 1083%)
        HWF-KAN           28.2%  (max 31759%)
        Wavelet-KAN       30.2%  (max 51438%)
        SineKAN           85.6%  (max 768529%)

    Round 2 (features upgraded to a parametric damped-sinusoid fit
    concatenated with the original windowed-RMS features -- see
    sensor_features.extract_features_combined; this roughly HALVED every
    architecture's error, confirming the FEATURES, not the regressor, were
    the dominant accuracy bottleneck), re-tested on 8 pooled held-out-Kn
    splits (56 test points):
        SIREN              8.0%  (max 38%)       <- chosen (best both)
        B-spline KAN      10.0%  (max 137%)
        Chebyshev-KAN     13.9%  (max 856%)
        tanh-MLP          15.1%  (max 253%)
        Wavelet-KAN       23.7%  (max 1092%)
        HWF-KAN           29.9%  (max 8939%)
        SineKAN           64.2%  (max 30085%)
    An earlier pass at Round 2 (now fixed) computed feature-standardization
    statistics (mean/std) from the FULL dataset including held-out test
    points, a mild data-leakage bug that made B-spline KAN appear to have
    caught up to or surpassed SIREN; with train-only standardization
    statistics (correct protocol, numbers above), SIREN is unambiguously
    best on both median and worst-case error. We record this because it is
    a subtle, easy-to-miss preprocessing bug (feature standardization is
    easy to reach for as a harmless, "outside-the-model" step, but it must
    be fit on the training split alone like anything else) and because it
    is precisely the kind of thing that can flip an architecture-choice
    conclusion. See paper Sec. 5.2(C) for the full discussion."""
    mu, sd = Xtr.mean(0, keepdims=True), Xtr.std(0, keepdims=True) + 1e-8
    Xtr_n = (Xtr - mu) / sd
    Xte_n = (Xte - mu) / sd

    init_fn, apply_raw = ARCHS["siren"]
    apply_fn = lambda p, xx: apply_raw(p, xx, omega_0=omega_0)
    key = random.PRNGKey(seed)
    params = init_fn(key, [Xtr.shape[1], hidden, 1], omega_0=omega_0)
    optimizer = optax.adam(lr)
    opt_state = optimizer.init(params)
    Xj, Yj = jnp.asarray(Xtr_n), jnp.asarray(Ytr)

    def step(params, opt_state):
        def loss_fn(p):
            pred = apply_fn(p, Xj)
            l2 = sum(jnp.mean(c ** 2) for c in jax.tree_util.tree_leaves(p))
            return jnp.mean((pred - Yj) ** 2) + weight_decay * l2
        loss, grads = jax.value_and_grad(loss_fn)(params)
        updates, opt_state = optimizer.update(grads, opt_state, params)
        params = optax.apply_updates(params, updates)
        return params, opt_state, loss
    step = jax.jit(step)

    hist, best_loss, best_params = [], float("inf"), params
    for ep in range(epochs):
        params, opt_state, loss = step(params, opt_state)
        loss_f = float(loss)
        hist.append(loss_f)
        if loss_f < best_loss:
            best_loss, best_params = loss_f, params

    pred_test = np.asarray(apply_fn(best_params, jnp.asarray(Xte_n)))
    return best_params, (mu, sd), hist, pred_test, apply_fn


def kinetic_quadrature(nvel=40):
    """Gauss-Hermite nodes/weights for unweighted velocity integrals."""
    v, w = np.polynomial.hermite.hermgauss(nvel)
    return v, w * np.exp(v*v)


def kinetic_moments(g, h, v, w, xp=jnp):
    """Last axis is velocity; all fields and stress come from the same g,h."""
    rho = xp.sum(g*w, axis=-1)
    momentum = xp.sum(g*(w*v), axis=-1)
    u = momentum / xp.maximum(rho, 1e-12)
    energy = 0.5*xp.sum((g*v*v+h)*w, axis=-1)
    p = (2.0/3.0)*(energy-0.5*momentum*u)
    Pxx = xp.sum(g*w*(v-u[..., None])**2, axis=-1)
    flux = xp.sum(g*w*v*v, axis=-1)
    q = 0.5*xp.sum((v-u[..., None])*((v-u[..., None])**2*g+h)*w, axis=-1)
    return dict(rho=rho, u=u, p=p, T=p/xp.maximum(rho, 1e-12),
                momentum=momentum, energy=energy, Pxx=Pxx,
                Pi_xx=Pxx-p, momentum_flux=flux, q=q)


def kinetic_projection(v, w, xp=jnp):
    """Weighted least-norm correction preserving discrete mass/momentum/energy.

    B maps a moment defect to distribution corrections. A @ B = identity.
    The corrected equilibrium is a numerical approximation to Maxwellian;
    its positivity must be monitored, particularly on coarse velocity grids.
    """
    z = xp.zeros_like(v)
    A = xp.stack([xp.concatenate([w, z]), xp.concatenate([w*v, z]),
                  xp.concatenate([0.5*w*v*v, 0.5*w])])
    base = xp.exp(-v*v/2)/xp.sqrt(2*xp.pi)
    D = xp.concatenate([base, 2*base])
    DA = D[:, None]*A.T
    B = xp.linalg.solve(A@DA, DA.T).T
    return A, B


def kinetic_equilibrium(g, h, v, w, A, B, xp=jnp):
    m = kinetic_moments(g, h, v, w, xp)
    T = xp.maximum(m['T'], 1e-8)
    ge = m['rho'][..., None]/xp.sqrt(2*xp.pi*T[..., None])*xp.exp(
        -(v-m['u'][..., None])**2/(2*T[..., None]))
    he = 2*T[..., None]*ge
    eq = xp.concatenate([ge, he], axis=-1)
    gh = xp.concatenate([g, h], axis=-1)
    eq = eq + ((gh-eq)@A.T)@B.T
    return eq[..., :len(v)], eq[..., len(v):]


def kinetic_siren_apply(params, x, omega_0=30.0):
    """Paired with siren_init: frequency scaling in EVERY hidden layer.

    Legacy benchmark networks are retained unchanged; this corrected
    convention is used only for the new kinetic reconstruction network.
    """
    for i, (W, b) in enumerate(params):
        x = x@W+b
        if i < len(params)-1:
            x = jnp.sin(omega_0*x)
    return x


def kinetic_distribution(params, xt, v, k, eps, t_max, n_harmonics=2,
                         omega_0=30.0):
    """Positive g,h with known Maxwellian initial condition enforced at t=0.

    Input xt=(x,physical time). A time network predicts Fourier coefficients
    of log-distribution corrections at each velocity node. No reference
    distributions/stresses or true Kn are inputs to this function.
    """
    x, t = xt[0], xt[1]
    tn = t/t_max
    modes = jnp.arange(1, n_harmonics+1)*k
    basis = jnp.concatenate([jnp.ones(1), jnp.sin(modes*x), jnp.cos(modes*x)])
    nc = 1+2*n_harmonics
    coefs = kinetic_siren_apply(params, tn.reshape(1, 1), omega_0).reshape(2, len(v), nc)
    corr = jnp.einsum('avc,c->av', coefs, basis)
    rho_i = 1+eps*jnp.sin(k*x)
    u_i = eps*jnp.sin(k*x)
    p_i = 1+eps*jnp.sin(k*x)
    T_i = p_i/rho_i
    log_g0 = jnp.log(rho_i)-0.5*jnp.log(2*jnp.pi*T_i)-(v-u_i)**2/(2*T_i)
    log_h0 = jnp.log(2*T_i)+log_g0
    log_base = -0.5*jnp.log(2*jnp.pi)-v*v/2
    initial = jnp.stack([log_g0, log_h0])
    base = jnp.stack([log_base, jnp.log(2.)+log_base])
    return jnp.exp((1-tn)*initial+tn*(base+eps*corr))


def kinetic_point_residual(params, xt, v, w, A, B, tau, k, eps, t_max,
                           n_harmonics=2):
    """BGK closure plus exact-form kinetic mass/momentum, via autodiff.

    No Euler pressure substitution, finite-difference flux, or truth stress.
    Returned residuals retain physical units (dimensionless simulation units).
    """
    fun = lambda z: kinetic_distribution(params, z, v, k, eps, t_max, n_harmonics)
    gh = fun(xt)
    deriv = jax.jacfwd(fun)(xt)  # (2,nvel,2), last axis x,t
    g, h = gh[0], gh[1]
    ge, he = kinetic_equilibrium(g, h, v, w, A, B)
    eq = jnp.stack([ge, he])
    bgk = deriv[..., 1]+v*deriv[..., 0]-(eq-gh)/tau
    mass = jnp.sum(w*(deriv[0, :, 1]+v*deriv[0, :, 0]))
    momentum = jnp.sum(w*(v*deriv[0, :, 1]+v*v*deriv[0, :, 0]))
    energy = 0.5*jnp.sum(w*(v*v*(deriv[0, :, 1]+v*deriv[0, :, 0])
                                   +deriv[1, :, 1]+v*deriv[1, :, 0]))
    return bgk, jnp.stack([mass, momentum, energy]), jnp.min(eq)


def reconstruct_kinetic_sensors(t, x_sensor, p_meas, u_meas, *, eps=1e-3,
        k=8*np.pi, Kn_estimate=None, tau_initial=0.03, nvel=40,
        n_harmonics=2, n_epochs=1200, lr=1e-3, lam_phys=0.02,
        lam_momentum=1.0, lam_mass=1.0, seed=0, n_collocation=128,
        sensor_batch=256, x_eval=None, verbose=False):
    """Train using ONLY p,u sensors and the known initial excitation.

    Kn_estimate: independent sensor-based estimate, frozen if supplied.
    Otherwise tau is jointly optimized from tau_initial; its identifiability
    is NOT guaranteed. This exploratory estimate is not the legacy 8% result.
    Reference fields/true Kn are deliberately absent from this API.
    Dependencies: numpy scipy matplotlib jax optax. CPU or JAX-supported GPU.
    """
    t = np.asarray(t, float); xs = np.asarray(x_sensor, float)
    pm = np.asarray(p_meas, float); um = np.asarray(u_meas, float)
    if t.ndim != 1 or len(t)<2 or np.any(np.diff(t)<=0) or t[0]<0:
        raise ValueError('t must be increasing physical times starting at or after zero')
    if pm.shape != (len(t), len(xs)) or um.shape != pm.shape:
        raise ValueError('p_meas and u_meas must have shape (len(t),len(x_sensor))')
    if not all(np.all(np.isfinite(a)) for a in [t,xs,pm,um]):
        raise ValueError('sensor arrays must be finite')
    if eps <= 0 or n_epochs < 1 or nvel < 8 or n_harmonics < 1:
        raise ValueError('positive eps/epochs/harmonics and nvel>=8 required')
    if Kn_estimate is not None and (not np.isfinite(Kn_estimate) or Kn_estimate <= 0):
        raise ValueError('Kn_estimate must be positive and finite')
    if tau_initial <= 0:
        raise ValueError('tau_initial must be positive')
    t_max = float(t[-1]); v0, w0 = kinetic_quadrature(nvel)
    v, w = jnp.asarray(v0), jnp.asarray(w0)
    A, B = kinetic_projection(v, w)
    # Physical sensor pairs: flatten in time-major order.
    points = jnp.asarray(np.column_stack([np.tile(xs,len(t)), np.repeat(t,len(xs))]))
    targets = jnp.asarray(np.column_stack([pm.ravel(),um.ravel()]))
    net = siren_init(random.PRNGKey(seed), [1,32,32,2*nvel*(1+2*n_harmonics)], omega_0=30.)
    params = dict(net=net, log_tau=jnp.log(jnp.asarray(tau_initial)))
    optimizer = optax.chain(optax.clip_by_global_norm(10.), optax.adam(lr))
    state = optimizer.init(params)
    # Smooth stiffness scaling changes loss weighting, not the BGK equation.
    base = jnp.exp(-v*v/2)/jnp.sqrt(2*jnp.pi)
    velocity_scale = jnp.stack([base,2*base])+1e-12
    tau_scale = 1/(k*jnp.sqrt(5/3))
    def tau_of(par):
        return (jnp.asarray(Kn_estimate) if Kn_estimate is not None
                else jnp.exp(jnp.clip(par['log_tau'],np.log(1e-6),np.log(1e3))))
    def losses(par, sp, sy, cp):
        def sensor(z):
            gh = kinetic_distribution(par['net'],z,v,k,eps,t_max,n_harmonics)
            m = kinetic_moments(gh[0],gh[1],v,w)
            return jnp.stack([m['p'],m['u']])
        pred = jax.vmap(sensor)(sp)
        ld = jnp.mean(((pred-sy)/eps)**2)
        tau = tau_of(par)
        rb, rc, min_eq = jax.vmap(lambda z: kinetic_point_residual(
            par['net'],z,v,w,A,B,tau,k,eps,t_max,n_harmonics))(cp)
        factor = jax.lax.stop_gradient(tau*tau_scale/(tau+tau_scale))
        lb = jnp.mean((rb*factor/(eps*velocity_scale))**2)
        cm = jnp.mean((rc*tau_scale/eps)**2,axis=0)
        # Energy is already constrained by BGK; report it independently.
        loss = ld+lam_phys*(lb+lam_mass*cm[0]+lam_momentum*cm[1])
        return loss, jnp.stack([ld,lb,cm[0],cm[1],cm[2],jnp.min(min_eq),tau])
    @jax.jit
    def step(par, st, sp, sy, cp):
        (value, aux), grads = jax.value_and_grad(losses,has_aux=True)(par,sp,sy,cp)
        updates, st = optimizer.update(grads,st,par)
        return optax.apply_updates(par,updates), st, value, aux
    rng = np.random.default_rng(seed+73); hist=[]; diagnostics=[]
    for ep in range(n_epochs):
        idx = rng.integers(0,len(points),size=min(sensor_batch,len(points)))
        cp = jnp.asarray(np.column_stack([rng.uniform(0,1,n_collocation),
                                         rng.uniform(0,t_max,n_collocation)]))
        params,state,value,aux = step(params,state,points[idx],targets[idx],cp)
        value=float(value)
        if not np.isfinite(value):
            raise FloatingPointError('Non-finite kinetic loss; reduce learning rate/check quadrature')
        hist.append(value); diagnostics.append(np.asarray(aux).tolist())
        if verbose and (ep==0 or (ep+1)%100==0 or ep==n_epochs-1):
            print(f'kinetic epoch {ep+1}/{n_epochs}: loss={value:.6g}, tau={float(tau_of(params)):.6g}',flush=True)
    xe = np.asarray([0.37] if x_eval is None else x_eval,float)
    eval_points = np.column_stack([np.tile(xe,len(t)),np.repeat(t,len(xe))])
    @jax.jit
    def eval_batch(z):
        gh = jax.vmap(lambda point: kinetic_distribution(
            params['net'],point,v,k,eps,t_max,n_harmonics))(z)
        return kinetic_moments(gh[:,0],gh[:,1],v,w)
    blocks = [eval_batch(jnp.asarray(eval_points[i:i+512])) for i in range(0,len(eval_points),512)]
    fields = {name:np.concatenate([np.asarray(b[name]) for b in blocks]).reshape(len(t),len(xe))
              for name in blocks[0]}
    return dict(t=t, x_eval=xe, fields=fields, loss_hist=hist,
                loss_components=diagnostics,
                loss_component_names=['data','BGK','mass','kinetic_momentum','energy_diagnostic',
                                      'min_corrected_equilibrium','tau'],
                tau_used=float(tau_of(params)), tau_mode='fixed_estimate' if Kn_estimate is not None else 'joint_exploratory',
                formulation='reduced_BGK_kinetic_momentum_v1',nvel=nvel,
                n_harmonics=n_harmonics, n_epochs=n_epochs,
                note='Training diagnostics are not a convergence or identifiability certificate.')


def reconstruct_field(Kn_true, regime='linear', eps=1e-3, n_sensors=N_SENSORS,
        noise_std_frac=0.01, seed=0, n_epochs=1200, lam_phys=0.02, lr=1e-3,
        Kn_estimate=None, NX=96, Nvel=40, T_final=0.6, **kinetic_kwargs):
    """Synthetic demo wrapper. Kn_true is used ONLY by the data generator.

    The training API receives sparse p,u and known excitation, never reference
    g,h,Pxx,Pi_xx or Kn_true. Use Kn_estimate from an independent inverse map
    to freeze tau; otherwise the kinetic network fits tau jointly.
    """
    d=run_bgk_acoustic(Kn_true,eps=eps,NX=NX,Nvel=Nvel,T_final=T_final,CFL=0.4)
    rng=np.random.default_rng(seed)
    test_idx=int(np.argmin(np.abs(d['x']-0.37)))
    candidates=np.setdiff1d(np.arange(NX),[test_idx])
    if not 1<=n_sensors<=len(candidates): raise ValueError('invalid sensor count')
    idx=np.sort(rng.choice(candidates,size=n_sensors,replace=False))
    sens=sample_sensors(d,idx,('p','u'))
    pm=sens['p']+rng.normal(size=sens['p'].shape)*noise_std_frac*(sens['p'].std()+1e-12)
    um=sens['u']+rng.normal(size=sens['u'].shape)*noise_std_frac*(sens['u'].std()+1e-12)
    result=reconstruct_kinetic_sensors(d['t'],sens['x_sensor'],pm,um,eps=eps,k=d['k_wave'],
        Kn_estimate=Kn_estimate,nvel=Nvel,n_epochs=n_epochs,lr=lr,lam_phys=lam_phys,
        seed=seed,x_eval=[d['x'][test_idx]],**kinetic_kwargs)
    uf=result['fields']['u'][:,0]; truth=d['u'][:,test_idx]
    result.update(u_true=truth,u_recon=uf,rmse=float(np.sqrt(np.mean((uf-truth)**2))),
        x_sensor=sens['x_sensor'],x_test=float(d['x'][test_idx]),sens_p=pm,sens_u=um,
        t_sensor=d['t'],reference_Kn=float(Kn_true),
        Pxx_true=d['Pxx'][:,test_idx],Pi_xx_true=d['Pi_xx'][:,test_idx])
    return result


def held_out_split(Xall, meta, frac_test=0.2, seed=0, edge_margin=2):
    """Hold out entire Kn values for testing, EXCLUDING the extreme edges of
    the sampled Kn range (edge_margin values on each end always stay in the
    training set). This keeps the reported test error an interpolation
    metric -- extrapolating a regressor beyond its training support is a
    fundamentally different (and here, uninformative) task; the same
    restriction would apply to any real calibration procedure, which is
    likewise only trusted to interpolate between calibration points."""
    rng = np.random.default_rng(seed)
    unique_Kn = np.array(sorted(set(m["Kn"] for m in meta)))
    candidates = unique_Kn[edge_margin:len(unique_Kn) - edge_margin] if len(unique_Kn) > 2 * edge_margin + 2 else unique_Kn
    n_test_Kn = max(4, int(round(frac_test * len(unique_Kn))))
    n_test_Kn = min(n_test_Kn, len(candidates))
    test_Kn_set = set(rng.choice(candidates, size=n_test_Kn, replace=False).tolist())
    is_test = np.array([m["Kn"] in test_Kn_set for m in meta])
    Xtr = Xall[~is_test]
    seen_kn, keep = set(), []
    for i, m in enumerate(meta):
        if is_test[i] and m["Kn"] not in seen_kn:
            keep.append(i); seen_kn.add(m["Kn"])
    return Xtr, is_test, keep, unique_Kn


def run_inverse_pikan_main():
    t0 = time.time()
    Kn_calib = np.geomspace(3e-4, 3.0, 34)

    # --- Primary experiment: LINEAR acoustic regime (well-posed; monotonic
    #     damping-Kn relation -> reliable regime identification). Results
    #     are pooled over several independent held-out-Kn splits, since a
    #     single 5-point holdout is too small to give a stable median. ---
    Xlin, Ylin, meta_lin = build_calibration_dataset(Kn_calib, regimes=("linear",), n_sensor_draws=5)
    Kn_true_test_all, Kn_pred_test_all, hist = [], [], None
    for split_seed in range(8):
        Xtr, is_test, keep, unique_Kn = held_out_split(Xlin, meta_lin, seed=split_seed)
        Ytr = Ylin[~is_test]
        Xte, Yte = Xlin[keep], Ylin[keep]
        net_inv, (mu, sd), hist_s, pred_test, inv_apply_fn = train_inverse_map(
            Xtr, Ytr, Xte, hidden=16, omega_0=1.0, epochs=4000, lr=3e-3, weight_decay=1e-3,
            seed=7 + split_seed)
        Kn_true_test_all.append(10 ** Yte.squeeze())
        Kn_pred_test_all.append(10 ** pred_test.squeeze())
        if hist is None:
            hist = hist_s
    Kn_true_test = np.concatenate([np.atleast_1d(a) for a in Kn_true_test_all])
    Kn_pred_test = np.concatenate([np.atleast_1d(a) for a in Kn_pred_test_all])
    test_rel_err = np.abs(Kn_pred_test - Kn_true_test) / Kn_true_test
    print("[linear] pooled test relative errors (%):", np.round(test_rel_err * 100, 2))
    print("[linear] median test relative error (%):", np.median(test_rel_err) * 100)

    # --- Secondary experiment: LINEAR + NONLINEAR combined regime, included
    #     to characterize the harder / partially non-monotonic case (see
    #     Discussion: nonlinear acoustic damping vs Kn is non-monotonic at
    #     large Kn, which degrades identifiability from decay-rate features
    #     alone). Also pooled over several held-out splits. ---
    Xall, Yall, meta = build_calibration_dataset(Kn_calib, regimes=("linear", "nonlinear"), n_sensor_draws=5)
    Kn_true_test2_all, Kn_pred_test2_all = [], []
    for split_seed in range(8):
        Xtr2, is_test2, keep2, unique_Kn2 = held_out_split(Xall, meta, seed=10 + split_seed)
        Ytr2 = Yall[~is_test2]
        Xte2, Yte2 = Xall[keep2], Yall[keep2]
        net_inv2, _, hist2, pred_test2, _ = train_inverse_map(
            Xtr2, Ytr2, Xte2, hidden=16, omega_0=1.0, epochs=4000, lr=3e-3, weight_decay=1e-3,
            seed=9 + split_seed)
        Kn_true_test2_all.append(10 ** Yte2.squeeze())
        Kn_pred_test2_all.append(10 ** pred_test2.squeeze())
    Kn_true_test2 = np.concatenate([np.atleast_1d(a) for a in Kn_true_test2_all])
    Kn_pred_test2 = np.concatenate([np.atleast_1d(a) for a in Kn_pred_test2_all])
    test_rel_err2 = np.abs(Kn_pred_test2 - Kn_true_test2) / Kn_true_test2
    print("[combined] median test relative error (%):", np.median(test_rel_err2) * 100)

    # --- Regime-classification accuracy (see regime_of_Kn docstring): a
    #     coarser but arguably more practically relevant metric than
    #     continuous Kn regression error -- does the model at least put the
    #     flow in the right collisional regime? ---
    class_acc_lin, conf_lin = classification_accuracy(Kn_true_test, Kn_pred_test)
    class_acc_comb, conf_comb = classification_accuracy(Kn_true_test2, Kn_pred_test2)
    print(f"[linear] regime-classification accuracy: {class_acc_lin*100:.1f}%")
    print(f"[combined] regime-classification accuracy: {class_acc_comb*100:.1f}%")
    print("[linear] confusion matrix (rows=true, cols=predicted):", json.dumps(conf_lin, indent=2))

    plt.figure(figsize=(4.3, 3.6))
    plt.semilogy(hist)
    plt.xlabel("epoch"); plt.ylabel("MSE (log10 Kn)")
    plt.title("Inverse-map SIREN training")
    plt.grid(True); plt.tight_layout()
    plt.savefig(f"{OUT}/inverse_map_training.png", dpi=150)
    plt.close()

    plt.figure(figsize=(4.8, 4.8))
    lims = [2e-4, 5.0]
    plt.loglog(lims, lims, "k--", lw=1, label="ideal")
    plt.loglog(Kn_true_test, Kn_pred_test, "o", color="crimson", ms=8,
               label=f"linear regime (median err {np.median(test_rel_err)*100:.0f}%)")
    plt.loglog(Kn_true_test2, Kn_pred_test2, "^", color="steelblue", ms=7,
               label=f"linear+nonlinear combined (median err {np.median(test_rel_err2)*100:.0f}%)")
    plt.xlabel("true Kn"); plt.ylabel("identified Kn")
    plt.title("Regime identification from sparse sensors,\nheld-out Knudsen numbers")
    plt.legend(fontsize=8); plt.grid(True, which="both", alpha=0.4)
    plt.tight_layout()
    plt.savefig(f"{OUT}/inverse_Kn_accuracy.png", dpi=150)
    plt.close()

    # --- confusion-matrix figure (linear regime; only the 3 regimes reached
    #     by our Kn range 3e-4..3 have any support -- free-molecular,
    #     Kn>=10, is outside the range tested and is reported as N/A) ---
    present_regimes = [r for r in REGIME_ORDER if sum(conf_lin[r].values()) > 0]
    M = np.array([[conf_lin[t][p] for p in present_regimes] for t in present_regimes])
    fig, ax = plt.subplots(figsize=(4.2, 3.8))
    im = ax.imshow(M, cmap="Blues")
    for i in range(len(present_regimes)):
        for j in range(len(present_regimes)):
            ax.text(j, i, str(M[i, j]), ha="center", va="center",
                    color="white" if M[i, j] > M.max() / 2 else "black")
    ax.set_xticks(range(len(present_regimes))); ax.set_xticklabels(present_regimes, rotation=30, ha="right")
    ax.set_yticks(range(len(present_regimes))); ax.set_yticklabels(present_regimes)
    ax.set_xlabel("identified regime"); ax.set_ylabel("true regime")
    ax.set_title(f"Regime classification (linear),\naccuracy={class_acc_lin*100:.0f}%")
    plt.tight_layout()
    plt.savefig(f"{OUT}/inverse_regime_confusion.png", dpi=150)
    plt.close()

    calib_table = [{"regime": m["regime"], "Kn_true": m["Kn"]} for m in meta]
    with open(f"{OUT}/inverse_calibration_meta.json", "w") as f:
        json.dump(calib_table, f, indent=2)
    # --- Well-posed sub-problem: restrict to the monotonically INCREASING
    #     branch of the damping-rate-vs-Kn curve (Kn <~ 0.05, see Table
    #     "damping_rates" / paper Sec. 4.1: gamma(Kn) rises from t=0.001 to
    #     a peak near Kn=0.05 before falling again at larger Kn). Below the
    #     peak, the map Kn -> gamma is one-to-one, so the inverse problem is
    #     genuinely well-posed rather than merely well-approximated -- unlike
    #     the full-range problem above, where the SAME decay rate can
    #     correspond to two different Kn values on either side of the peak.
    #     This range also covers most practical continuum/early-slip
    #     engineering applications (e.g. MEMS microflows), where Kn is often
    #     known a priori to be below this peak. Same protocol as above. ---
    Kn_calib_wp = np.geomspace(3e-4, 5e-2, 24)
    Xwp, Ywp, meta_wp = build_calibration_dataset(Kn_calib_wp, regimes=("linear",), n_sensor_draws=5)
    Kn_true_wp_all, Kn_pred_wp_all = [], []
    for split_seed in range(8):
        Xtr_wp, is_test_wp, keep_wp, unique_Kn_wp = held_out_split(Xwp, meta_wp, seed=split_seed, edge_margin=2)
        Ytr_wp = Ywp[~is_test_wp]
        Xte_wp, Yte_wp = Xwp[keep_wp], Ywp[keep_wp]
        net_inv_wp, _, _, pred_test_wp, _ = train_inverse_map(
            Xtr_wp, Ytr_wp, Xte_wp, hidden=16, omega_0=1.0, epochs=4000, lr=3e-3, weight_decay=1e-3,
            seed=7 + split_seed)
        Kn_true_wp_all.append(10 ** Yte_wp.squeeze())
        Kn_pred_wp_all.append(10 ** pred_test_wp.squeeze())
    Kn_true_wp = np.concatenate([np.atleast_1d(a) for a in Kn_true_wp_all])
    Kn_pred_wp = np.concatenate([np.atleast_1d(a) for a in Kn_pred_wp_all])
    test_rel_err_wp = np.abs(Kn_pred_wp - Kn_true_wp) / Kn_true_wp
    class_acc_wp, conf_wp = classification_accuracy(Kn_true_wp, Kn_pred_wp)
    print(f"[well-posed sub-problem] median rel. err (%): {np.median(test_rel_err_wp)*100:.2f}, "
          f"max: {np.max(test_rel_err_wp)*100:.2f}, classification acc: {class_acc_wp*100:.1f}%")

    plt.figure(figsize=(4.8, 4.8))
    lims_wp = [2e-4, 8e-2]
    plt.loglog(lims_wp, lims_wp, "k--", lw=1, label="ideal")
    plt.loglog(Kn_true_wp, Kn_pred_wp, "o", color="seagreen", ms=8,
               label=f"continuum-slip sub-problem\n(median err {np.median(test_rel_err_wp)*100:.1f}%)")
    plt.xlabel("true Kn"); plt.ylabel("identified Kn")
    plt.title("Well-posed sub-problem: Kn $\\leq$ 0.05\n(monotonic branch of $\\gamma$(Kn))")
    plt.legend(fontsize=8); plt.grid(True, which="both", alpha=0.4)
    plt.tight_layout()
    plt.savefig(f"{OUT}/inverse_Kn_accuracy_wellposed.png", dpi=150)
    plt.close()

    summary = {
        "n_calibration_points_linear": int(Xlin.shape[0]),
        "n_calibration_points_combined": int(Xall.shape[0]),
        "n_unique_Kn": int(len(unique_Kn)),
        "n_test_linear": int(len(Kn_true_test)),
        "n_test_combined": int(len(Kn_true_test2)),
        "median_test_rel_err_pct_linear": float(np.median(test_rel_err) * 100),
        "max_test_rel_err_pct_linear": float(np.max(test_rel_err) * 100),
        "median_test_rel_err_pct_combined": float(np.median(test_rel_err2) * 100),
        "max_test_rel_err_pct_combined": float(np.max(test_rel_err2) * 100),
        "regime_classification_accuracy_pct_linear": float(class_acc_lin * 100),
        "regime_classification_accuracy_pct_combined": float(class_acc_comb * 100),
        "regime_confusion_matrix_linear": conf_lin,
        "regime_boundaries": "continuum: Kn<1e-2, slip: 1e-2<=Kn<1e-1, transitional: 1e-1<=Kn<10, free-molecular: Kn>=10",
        "wellposed_subproblem_Kn_range": [float(Kn_calib_wp.min()), float(Kn_calib_wp.max())],
        "wellposed_subproblem_n_test": int(len(Kn_true_wp)),
        "wellposed_subproblem_median_rel_err_pct": float(np.median(test_rel_err_wp) * 100),
        "wellposed_subproblem_max_rel_err_pct": float(np.max(test_rel_err_wp) * 100),
        "wellposed_subproblem_classification_acc_pct": float(class_acc_wp * 100),
        "feature_names": FEATURE_NAMES,
        "n_sensors": N_SENSORS,
    }

    print("Running field-reconstruction demo (physics-regularized)...")
    Kn_demo = 1e-2
    rec = reconstruct_field(Kn_demo, regime="linear", eps=1e-3, n_sensors=N_SENSORS, n_epochs=1200)
    summary["field_reconstruction_demo_Kn"] = Kn_demo
    summary["field_reconstruction_rmse"] = rec["rmse"]
    summary["kinetic_reconstruction_tau"] = rec["tau_used"]
    summary["kinetic_reconstruction_tau_mode"] = rec["tau_mode"]

    plt.figure(figsize=(5.5, 3.5))
    plt.plot(rec["t"], rec["u_true"], "k-", lw=2, label="DVM-BGK")
    plt.plot(rec["t"], rec["u_recon"], "r--", lw=2, label="Kinetic SIREN reconstruction")
    plt.xlabel("t"); plt.ylabel(f"u(x={rec['x_test']:.2f}, t)")
    plt.title(f"Sparse-sensor field reconstruction (Kn={Kn_demo:g}, "
              f"{N_SENSORS} sensors at x={np.round(rec['x_sensor'],2).tolist()})")
    plt.legend(fontsize=8); plt.grid(True); plt.tight_layout()
    plt.savefig(f"{OUT}/inverse_reconstruction_example.png", dpi=150)
    plt.close()

    with open(f"{OUT}/inverse_summary.json", "w") as f:
        json.dump(summary, f, indent=2)
    print(json.dumps(summary, indent=2))
    print("Inverse study complete. total time", time.time() - t0)


