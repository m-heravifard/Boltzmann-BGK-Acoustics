implemented with
JAX automatic differentiation.

Each layer replaces the fixed nonlinearity + linear-weight structure of an
MLP with learnable univariate edge functions expanded in a Chebyshev
polynomial basis:

    y_j = sum_i  sum_{k=0}^{K} c_{i,j,k} * T_k( tanh(x_i) )

`tanh` squashes inputs to (-1,1) (the domain of the Chebyshev polynomials)
in a smooth, differentiable way. T_k are generated by the stable
recurrence T_0=1, T_1=z, T_{k+1}=2 z T_k - T_{k-1}.

The network is written in the standard JAX functional style: parameters
are a pytree (a list of per-layer coefficient arrays), `apply(params, x)`
is a pure function, and `jax.grad`/`jax.value_and_grad` differentiate
directly through it -- no custom autodiff engine is needed. Optimization
uses `optax.adam`.
"""
jax.config.update("jax_enable_x64", True)  # match the precision of the
                                            # original float64 NumPy pipeline;
                                            # Chebyshev-KAN regression on
                                            # widely-scaled physical features
                                            # benefits materially from x64.


def init_layer(key, in_dim, out_dim, order):
    """Coefficients c[k]: shape (order+1, in_dim, out_dim), small init."""
    scale = 1.0 / (in_dim * (order + 1))
    return scale * random.normal(key, (order + 1, in_dim, out_dim))


def init_chebykan(key, layer_sizes, order=6):
    """Returns params: list of per-layer coefficient arrays."""
    keys = random.split(key, len(layer_sizes) - 1)
    return [init_layer(k, layer_sizes[i], layer_sizes[i + 1], order)
            for i, k in enumerate(keys)]


def chebyshev_basis(z, order):
    """z: (N,d) in (-1,1). Returns stacked basis, shape (order+1,N,d)."""
    T0 = jnp.ones_like(z)
    T1 = z

    def body(carry, _):
        Tkm1, Tk = carry
        Tkp1 = 2 * z * Tk - Tkm1
        return (Tk, Tkp1), Tkp1

    if order == 0:
        return T0[None, ...]
    (_, _), rest = jax.lax.scan(body, (T0, T1), None, length=order - 1)
    return jnp.concatenate([T0[None, ...], T1[None, ...], rest], axis=0)


def cheby_layer_apply(coeffs, x):
    """coeffs: (order+1, in_dim, out_dim). x: (N,in_dim) -> (N,out_dim)."""
    order = coeffs.shape[0] - 1
    z = jnp.tanh(x)
    basis = chebyshev_basis(z, order)  # (order+1, N, in_dim)
    # y = sum_k basis[k] @ coeffs[k]
    return jnp.einsum("kni,kio->no", basis, coeffs)


def apply(params, x):
    """Full network forward pass. params: list of layer coeff arrays."""
    h = x
    n_layers = len(params)
    for idx, coeffs in enumerate(params):
        h = cheby_layer_apply(coeffs, h)
        if idx < n_layers - 1:
            h = jnp.tanh(h)
    return h


def make_optimizer(lr):
    return optax.adam(lr)


def mse_loss(params, X, Y):
    pred = apply(params, X)
    return jnp.mean((pred - Y) ** 2)


def l2_penalty(params):
    return sum(jnp.mean(c ** 2) for c in params)


@jax.jit
def train_step(params, opt_state, X, Y, optimizer, weight_decay=0.0):
    def loss_fn(p):
        loss = mse_loss(p, X, Y)
        if weight_decay > 0.0:
            loss = loss + weight_decay * l2_penalty(p)
        return loss

    loss, grads = jax.value_and_grad(loss_fn)(params)
    updates, opt_state = optimizer.update(grads, opt_state, params)
    params = optax.apply_updates(params, updates)
    return params, opt_state, loss


def fit(params, X, Y, lr=1e-2, epochs=1000, weight_decay=0.0, verbose=False,
        log_every=200, tag=""):
    """Full-batch training loop using JAX autodiff + optax.adam. Returns the
    best-loss parameter snapshot (checkpointed each epoch) rather than
    simply the final iterate, since full-batch Adam on a small dataset can
    show late-training loss spikes."""
    Xj, Yj = jnp.asarray(X), jnp.asarray(Y)
    optimizer = make_optimizer(lr)
    opt_state = optimizer.init(params)

    def step(params, opt_state):
        def loss_fn(p):
            loss = mse_loss(p, Xj, Yj)
            if weight_decay > 0.0:
                loss = loss + weight_decay * l2_penalty(p)
            return loss
        loss, grads = jax.value_and_grad(loss_fn)(params)
        updates, opt_state = optimizer.update(grads, opt_state, params)
        params = optax.apply_updates(params, updates)
        return params, opt_state, loss
    step = jax.jit(step)

    hist = []
    best_loss = float("inf")
    best_params = params
    for ep in range(epochs):
        params, opt_state, loss = step(params, opt_state)
        loss_f = float(loss)
        hist.append(loss_f)
        if loss_f < best_loss:
            best_loss = loss_f
            best_params = params
        if verbose and ep % log_every == 0:
            print(f"  [{tag}] epoch {ep} loss={loss_f:.4e}")
    return best_params, hist


