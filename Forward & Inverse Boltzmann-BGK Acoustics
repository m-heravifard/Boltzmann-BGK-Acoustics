"""
A small zoo of JAX-based function-approximator architectures, all sharing
the interface

    params = init(key, layer_sizes, **kwargs)
    y      = apply(params, x)

so they can be dropped into identical training loops for a fair,
apples-to-apples comparison. Used in run_forward.py (Sec. 4.3 of the
paper) to test whether the Chebyshev-KAN forward surrogate's fit quality
is an architecture problem or a representation problem (it turns out to
be the latter -- see chebykan.py's spectral-coefficient ansatz).

Architectures:
  - chebykan   : Chebyshev-polynomial KAN (chebykan.py), included here via
                 thin wrappers for a uniform call signature.
  - mlp        : standard tanh multilayer perceptron (the classic PINN
                 architecture of Raissi et al. 2019).
  - siren      : sine-activation MLP (Sitzmann et al. 2020), designed
                 specifically to avoid the spectral bias that hobbles
                 tanh/ReLU MLPs on oscillatory targets.
  - bspline_kan: Kolmogorov-Arnold layer with the ORIGINAL cubic uniform
                 B-spline edge-function basis (Liu et al. 2024), rather
                 than the Chebyshev variant.
"""



# ----------------------------------------------------------------------
# Chebyshev-KAN (thin wrapper around chebykan.py for a uniform interface)
# ----------------------------------------------------------------------
def chebykan_init(key, layer_sizes, order=6, **kw):
    return init_chebykan(key, layer_sizes, order=order)


def chebykan_apply(params, x):
    return apply(params, x)


# ----------------------------------------------------------------------
# Standard tanh MLP ("vanilla" PINN architecture)
# ----------------------------------------------------------------------
def mlp_init(key, layer_sizes, **kw):
    keys = random.split(key, len(layer_sizes) - 1)
    params = []
    for i, k in enumerate(keys):
        fan_in, fan_out = layer_sizes[i], layer_sizes[i + 1]
        scale = jnp.sqrt(2.0 / fan_in)  # He/Glorot-ish init for tanh
        W = scale * random.normal(k, (fan_in, fan_out))
        b = jnp.zeros((fan_out,))
        params.append((W, b))
    return params


def mlp_apply(params, x):
    h = x
    n_layers = len(params)
    for idx, (W, b) in enumerate(params):
        h = h @ W + b
        if idx < n_layers - 1:
            h = jnp.tanh(h)
    return h


# ----------------------------------------------------------------------
# SIREN: sine-activation MLP (Sitzmann et al. 2020), with the paper's
# recommended omega_0-scaled initialization, specifically designed to
# represent high-frequency / oscillatory signals without spectral bias.
# ----------------------------------------------------------------------
def siren_init(key, layer_sizes, omega_0=30.0, **kw):
    keys = random.split(key, len(layer_sizes) - 1)
    params = []
    for i, k in enumerate(keys):
        fan_in, fan_out = layer_sizes[i], layer_sizes[i + 1]
        if i == 0:
            bound = 1.0 / fan_in
        else:
            bound = jnp.sqrt(6.0 / fan_in) / omega_0
        W = random.uniform(k, (fan_in, fan_out), minval=-bound, maxval=bound)
        b = jnp.zeros((fan_out,))
        params.append((W, b))
    return params


def siren_apply(params, x, omega_0=30.0):
    h = x
    n_layers = len(params)
    for idx, (W, b) in enumerate(params):
        z = h @ W + b
        if idx < n_layers - 1:
            h = jnp.sin(omega_0 * z) if idx == 0 else jnp.sin(z)
        else:
            h = z  # linear output layer
    return h


# ----------------------------------------------------------------------
# B-spline KAN: Kolmogorov-Arnold layer with cubic uniform B-spline edge
# functions (the original KAN parameterization), evaluated via the
# Cox-de Boor recursion (vectorized, JAX-differentiable).
# ----------------------------------------------------------------------
def _bspline_basis(x, knots, degree):
    """Cox-de Boor recursion. x: (...,), knots: (n_knots,). Returns basis
    of shape (n_basis, ...) where n_basis = n_knots - degree - 1."""
    knots = knots
    B = jnp.stack([((x >= knots[i]) & (x < knots[i + 1])).astype(x.dtype)
                    for i in range(len(knots) - 1)], axis=0)
    for d in range(1, degree + 1):
        newB = []
        for i in range(len(knots) - d - 1):
            denom1 = knots[i + d] - knots[i]
            denom2 = knots[i + d + 1] - knots[i + 1]
            term1 = jnp.where(denom1 > 1e-12, (x - knots[i]) / jnp.where(denom1 > 1e-12, denom1, 1.0), 0.0) * B[i]
            term2 = jnp.where(denom2 > 1e-12, (knots[i + d + 1] - x) / jnp.where(denom2 > 1e-12, denom2, 1.0), 0.0) * B[i + 1]
            newB.append(term1 + term2)
        B = jnp.stack(newB, axis=0)
    return B  # (n_basis, ...)


def _make_uniform_knots(n_grid, degree, lo=-1.2, hi=1.2):
    # open/clamped-ish uniform knot vector with `degree` extra repeats
    # at each end so the basis spans [lo, hi] cleanly.
    h = (hi - lo) / n_grid
    knots = lo + h * jnp.arange(-degree, n_grid + degree + 1)
    return knots


class BSplineConfig:
    def __init__(self, n_grid=6, degree=3):
        self.n_grid = n_grid
        self.degree = degree
        self.knots = _make_uniform_knots(n_grid, degree)
        self.n_basis = len(self.knots) - degree - 1


_BSPLINE_CFG = BSplineConfig(n_grid=6, degree=3)


def bspline_kan_init(key, layer_sizes, cfg=_BSPLINE_CFG, **kw):
    keys = random.split(key, len(layer_sizes) - 1)
    params = []
    for i, k in enumerate(keys):
        fan_in, fan_out = layer_sizes[i], layer_sizes[i + 1]
        scale = 1.0 / (fan_in * cfg.n_basis)
        coeffs = scale * random.normal(k, (cfg.n_basis, fan_in, fan_out))
        params.append(coeffs)
    return params


def _bspline_layer_apply(coeffs, x, cfg=_BSPLINE_CFG):
    """coeffs: (n_basis, in_dim, out_dim). x: (N, in_dim) -> (N, out_dim)."""
    z = jnp.tanh(x)  # squash to the spline's effective support, as in the
                      # Chebyshev layer, for a fair architectural comparison
    basis = _bspline_basis(z, cfg.knots, cfg.degree)  # (n_basis, N, in_dim)
    return jnp.einsum("kni,kio->no", basis, coeffs)


def bspline_kan_apply(params, x, cfg=_BSPLINE_CFG):
    h = x
    n_layers = len(params)
    for idx, coeffs in enumerate(params):
        h = _bspline_layer_apply(coeffs, h, cfg=cfg)
        if idx < n_layers - 1:
            h = jnp.tanh(h)
    return h


# ----------------------------------------------------------------------
# SineKAN: a SIREN/KAN hybrid. Same edge-function structure as the
# Chebyshev-KAN layer (learnable coefficients times a fixed basis of
# univariate functions of the input), but with the polynomial basis
# T_k(tanh(x)) replaced by a harmonic sine/cosine basis at SIREN-style
# omega_0-scaled frequencies:
#
#   y_j = sum_i sum_{k=1}^{K} [ a_{i,j,k} sin(omega_0 * k * x_i)
#                              + b_{i,j,k} cos(omega_0 * k * x_i) ]
#
# i.e. each edge is a learnable truncated Fourier series rather than a
# learnable Chebyshev series, evaluated directly on x (no tanh squashing
# -- sines/cosines are already globally bounded and periodic, so unlike
# the polynomial bases they do not need their input compressed to a
# fixed domain first). Frequencies are fixed at omega_0*k (as in SIREN's
# first-layer initialization); only the amplitude coefficients are
# trained. This combines SIREN's core idea (an oscillatory basis that
# does not suffer spectral bias against high-frequency targets) with
# KAN's core idea (learnable per-edge univariate functions rather than a
# fixed nonlinearity applied after a linear layer).
# ----------------------------------------------------------------------
def sinekan_init(key, layer_sizes, order=6, omega_0=1.0, **kw):
    keys = random.split(key, len(layer_sizes) - 1)
    params = []
    for i, k in enumerate(keys):
        fan_in, fan_out = layer_sizes[i], layer_sizes[i + 1]
        scale = 1.0 / (fan_in * order)
        ka, kb = random.split(k)
        a = scale * random.normal(ka, (order, fan_in, fan_out))
        b = scale * random.normal(kb, (order, fan_in, fan_out))
        params.append((a, b))
    return params


def _sinekan_layer_apply(a, b, x, omega_0):
    order = a.shape[0]
    out = None
    for kk in range(order):
        w = omega_0 * (kk + 1)
        term = jnp.sin(w * x) @ a[kk] + jnp.cos(w * x) @ b[kk]
        out = term if out is None else out + term
    return out


def sinekan_apply(params, x, omega_0=1.0):
    h = x
    n_layers = len(params)
    for idx, (a, b) in enumerate(params):
        h = _sinekan_layer_apply(a, b, h, omega_0)
        if idx < n_layers - 1:
            h = jnp.tanh(h)
    return h


# ----------------------------------------------------------------------
# Wavelet basis utilities: a fixed dictionary of real Morlet wavelets at
# several octave-spaced scales and translations spanning the input
# domain, psi_{a,b}(x) = cos(w0 (x-b)/a) * exp(-0.5 ((x-b)/a)^2). Unlike
# the Fourier/Chebyshev bases above (globally supported), wavelets are
# LOCALIZED in the input coordinate -- well suited in principle to a
# signal whose oscillation is not stationary (the acoustic coefficient
# functions of Sec. 4.2 oscillate rapidly at early time and are
# essentially flat/decayed at late time, i.e. their effective frequency
# content is itself time-dependent, which a fixed global Fourier
# dictionary cannot represent as compactly as a multi-scale wavelet one).
# As with SineKAN, only the linear amplitude coefficients are trained;
# scale and translation are a fixed frame, which keeps training as fast
# and stable as the other linear-in-parameters bases used here.
# ----------------------------------------------------------------------
def _wavelet_grid(n_scales=4, n_translations=5, lo=-1.2, hi=1.2, base_scale=0.5):
    scales, translations = [], []
    for s in range(n_scales):
        a = base_scale * (2.0 ** s)
        for b in np.linspace(lo, hi, n_translations):
            scales.append(a)
            translations.append(b)
    return jnp.asarray(scales), jnp.asarray(translations)


def morlet_basis(x, scales, translations, w0=5.0):
    """x: (...,). scales,translations: (M,). Returns (M, ...)."""
    z = (x[None, ...] - translations[:, None, None]) / scales[:, None, None]
    return jnp.cos(w0 * z) * jnp.exp(-0.5 * z ** 2)


_WAVELET_GRID = _wavelet_grid(n_scales=4, n_translations=5)  # M=20 wavelets


def _basis_layer_init(key, in_dim, out_dim, n_basis):
    scale = 1.0 / (in_dim * n_basis)
    return scale * random.normal(key, (n_basis, in_dim, out_dim))


def _basis_layer_apply(coeffs, basis):
    """coeffs: (n_basis,in_dim,out_dim). basis: (n_basis,N,in_dim). -> (N,out_dim)."""
    return jnp.einsum("kni,kio->no", basis, coeffs)


# ---------------------------------------------------------- Wavelet-KAN
def waveletkan_init(key, layer_sizes, n_scales=4, n_translations=5, **kw):
    n_basis = n_scales * n_translations
    keys = random.split(key, len(layer_sizes) - 1)
    return [_basis_layer_init(k, layer_sizes[i], layer_sizes[i + 1], n_basis)
            for i, k in enumerate(keys)]


def waveletkan_apply(params, x, n_scales=4, n_translations=5, w0=5.0, base_scale=0.5):
    scales, translations = _wavelet_grid(n_scales, n_translations, base_scale=base_scale)
    h = x
    n_layers = len(params)
    for idx, coeffs in enumerate(params):
        z = jnp.tanh(h)
        basis = morlet_basis(z, scales, translations, w0)  # (M,N,in_dim)
        h = _basis_layer_apply(coeffs, basis)
        if idx < n_layers - 1:
            h = jnp.tanh(h)
    return h


# --------------------------------------------------- Wavelet-embedded PINN
# A standard tanh-MLP (as in mlp_apply) but preceded by a FIXED wavelet
# feature embedding of the input coordinate, analogous to a Fourier-
# feature-embedded coordinate network (Tancik et al. 2020) but using a
# multi-scale wavelet dictionary instead of a single-scale sinusoidal one.
def wpinn_init(key, layer_sizes, n_scales=4, n_translations=5, **kw):
    n_feat = layer_sizes[0] * n_scales * n_translations
    mlp_sizes = [n_feat] + list(layer_sizes[1:])
    return mlp_init(key, mlp_sizes)


def wpinn_apply(params, x, n_scales=4, n_translations=5, w0=5.0, base_scale=0.5):
    scales, translations = _wavelet_grid(n_scales, n_translations, base_scale=base_scale)
    feats = morlet_basis(x, scales, translations, w0)  # (M,N,in_dim)
    M, N, D = feats.shape
    feats = jnp.transpose(feats, (1, 0, 2)).reshape(N, M * D)
    return mlp_apply(params, feats)


# ------------------------------------------ Hybrid Wavelet-Fourier (HWF)
# Concatenates the Fourier (SineKAN-style) and wavelet dictionaries into
# one combined basis -- HWF-KAN: a KAN edge function that can express
# BOTH globally periodic content (Fourier terms) and localized,
# scale-varying transients (wavelet terms) in the same learnable-
# coefficient layer; HWF-PINN: the analogous fixed-feature-embedded MLP.
def _hwf_basis(x, n_harmonics, omega_0, n_scales, n_translations, w0, base_scale=0.5):
    cols = []
    for kk in range(1, n_harmonics + 1):
        cols.append(jnp.sin(omega_0 * kk * x))
        cols.append(jnp.cos(omega_0 * kk * x))
    fourier = jnp.stack(cols, axis=0)  # (2H, N, D)
    scales, translations = _wavelet_grid(n_scales, n_translations, base_scale=base_scale)
    wavelet = morlet_basis(x, scales, translations, w0)  # (M, N, D)
    return jnp.concatenate([fourier, wavelet], axis=0)  # (2H+M, N, D)


def hwfkan_init(key, layer_sizes, n_harmonics=4, omega_0=50.0, n_scales=4,
                 n_translations=5, **kw):
    n_basis = 2 * n_harmonics + n_scales * n_translations
    keys = random.split(key, len(layer_sizes) - 1)
    return [_basis_layer_init(k, layer_sizes[i], layer_sizes[i + 1], n_basis)
            for i, k in enumerate(keys)]


def hwfkan_apply(params, x, n_harmonics=4, omega_0=50.0, n_scales=4,
                  n_translations=5, w0=5.0, base_scale=0.5):
    h = x
    n_layers = len(params)
    for idx, coeffs in enumerate(params):
        z = jnp.tanh(h)
        basis = _hwf_basis(z, n_harmonics, omega_0, n_scales, n_translations, w0, base_scale)
        h = _basis_layer_apply(coeffs, basis)
        if idx < n_layers - 1:
            h = jnp.tanh(h)
    return h


def hwfpinn_init(key, layer_sizes, n_harmonics=4, omega_0=50.0, n_scales=4,
                  n_translations=5, **kw):
    n_feat = layer_sizes[0] * (2 * n_harmonics + n_scales * n_translations)
    mlp_sizes = [n_feat] + list(layer_sizes[1:])
    return mlp_init(key, mlp_sizes)


def hwfpinn_apply(params, x, n_harmonics=4, omega_0=50.0, n_scales=4,
                   n_translations=5, w0=5.0, base_scale=0.5):
    basis = _hwf_basis(x, n_harmonics, omega_0, n_scales, n_translations, w0, base_scale)  # (2H+M,N,D)
    M, N, D = basis.shape
    feats = jnp.transpose(basis, (1, 0, 2)).reshape(N, M * D)
    return mlp_apply(params, feats)


# ----------------------------------------------------------------------
# Registry + generic training loop shared by all architectures
# ----------------------------------------------------------------------
ARCHS = {
    "chebykan":    (chebykan_init, chebykan_apply),
    "mlp_pinn":    (mlp_init, mlp_apply),
    "siren":       (siren_init, siren_apply),
    "bspline_kan": (bspline_kan_init, bspline_kan_apply),
    "sinekan":     (sinekan_init, sinekan_apply),
    "waveletkan":  (waveletkan_init, waveletkan_apply),
    "wpinn":       (wpinn_init, wpinn_apply),
    "hwfkan":      (hwfkan_init, hwfkan_apply),
    "hwfpinn":     (hwfpinn_init, hwfpinn_apply),
}


# kwargs each apply_fn actually accepts beyond (params, x) -- used so
# fit_generic can forward the SAME arch_kwargs to both init and apply
# (previously omega_0 only reached siren_init/sinekan_init, so the
# forward pass silently used the default omega_0 instead of the
# per-architecture-tuned value; fixed here).
_APPLY_KWARGS = {
    "chebykan": (), "mlp_pinn": (), "bspline_kan": (),
    "siren": ("omega_0",), "sinekan": ("omega_0",),
    "waveletkan": ("n_scales", "n_translations", "w0", "base_scale"),
    "wpinn": ("n_scales", "n_translations", "w0", "base_scale"),
    "hwfkan": ("n_harmonics", "omega_0", "n_scales", "n_translations", "w0", "base_scale"),
    "hwfpinn": ("n_harmonics", "omega_0", "n_scales", "n_translations", "w0", "base_scale"),
}


def fit_generic(arch_name, key, layer_sizes, X, Y, lr=3e-3, epochs=3000,
                 weight_decay=1e-7, arch_kwargs=None, verbose=False, tag=""):
    arch_kwargs = arch_kwargs or {}
    init_fn, apply_fn_raw = ARCHS[arch_name]
    apply_kw = {k: v for k, v in arch_kwargs.items() if k in _APPLY_KWARGS[arch_name]}
    apply_fn = (lambda p, xx: apply_fn_raw(p, xx, **apply_kw)) if apply_kw else apply_fn_raw
    params = init_fn(key, layer_sizes, **arch_kwargs)
    optimizer = optax.adam(lr)
    opt_state = optimizer.init(params)
    Xj, Yj = jnp.asarray(X), jnp.asarray(Y)

    def l2(params):
        leaves = jax.tree_util.tree_leaves(params)
        return sum(jnp.mean(p ** 2) for p in leaves)

    def loss_fn(p):
        pred = apply_fn(p, Xj)
        loss = jnp.mean((pred - Yj) ** 2)
        if weight_decay > 0.0:
            loss = loss + weight_decay * l2(p)
        return loss

    def step(params, opt_state):
        loss, grads = jax.value_and_grad(loss_fn)(params)
        updates, opt_state = optimizer.update(grads, opt_state, params)
        params = optax.apply_updates(params, updates)
        return params, opt_state, loss
    step = jax.jit(step)

    hist, best_loss, best_params = [], float("inf"), params
    for ep in range(epochs):
        params, opt_state, loss = step(params, opt_state)
        loss_f = float(loss)
        hist.append(loss_f)
        if loss_f < best_loss:
            best_loss, best_params = loss_f, params
        if verbose and ep % max(1, epochs // 5) == 0:
            print(f"  [{tag}/{arch_name}] epoch {ep} loss={loss_f:.4e}")
    return best_params, hist, apply_fn


