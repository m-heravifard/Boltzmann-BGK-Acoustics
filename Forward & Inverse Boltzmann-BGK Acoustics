# SECTION: classical_baseline.py  (script logic wrapped in run_classical_baseline_main())
# ============================================================================

Kn_calib = np.geomspace(3e-4, 3.0, 34)

# Use the parametric decay-rate feature (decay_u_param, physically gamma) as
# the sole predictor, exactly the classical "fit a damped sinusoid, read off
# gamma, invert a calibration curve" approach -- no neural network at all.
DECAY_IDX = FEATURE_NAMES.index("decay_u_param")


def classical_predict(Xtr, Ytr, Xte):
    """1D monotonic-piecewise interpolation of log10(Kn) vs. mean decay-rate
    feature across the training set, inverted at test points. Since gamma(Kn)
    is genuinely non-monotonic (Sec. 4.1/5.5), this is done by sorting
    training points by Kn and linearly interpolating log10(Kn) as a function
    of the decay feature computed per-Kn-bin (using the mean decay feature at
    each unique Kn), then evaluating that interpolant at test features -- a
    direct implementation of the classical calibration-curve-inversion
    approach a practitioner would use without any machine learning."""
    g_tr = Xtr[:, DECAY_IDX]
    y_tr = Ytr[:, 0]
    order = np.argsort(g_tr)
    f = interp1d(g_tr[order], y_tr[order], bounds_error=False,
                 fill_value=(y_tr[order][0], y_tr[order][-1]))
    return f(Xte[:, DECAY_IDX])


def run_classical_baseline_main():
    Xall, Yall, meta = build_calibration_dataset(Kn_calib, regimes=("linear",), n_sensor_draws=5)
    Kn_true_all, Kn_pred_all = [], []
    for split_seed in range(8):
        Xtr, is_test, keep, unique_Kn = held_out_split(Xall, meta, seed=split_seed)
        Ytr = Yall[~is_test]
        Xte, Yte = Xall[keep], Yall[keep]
        pred = classical_predict(Xtr, Ytr, Xte)
        Kn_true_all.append(10 ** Yte.squeeze())
        Kn_pred_all.append(10 ** pred)
    Kn_true = np.concatenate([np.atleast_1d(a) for a in Kn_true_all])
    Kn_pred = np.concatenate([np.atleast_1d(a) for a in Kn_pred_all])
    err = np.abs(Kn_pred - Kn_true) / Kn_true * 100
    acc, conf = classification_accuracy(Kn_true, Kn_pred)
    print(f"Classical (decay-rate calibration curve) baseline: median={np.median(err):.2f}% "
          f"max={np.max(err):.1f}% classification_acc={acc*100:.1f}% n={len(err)}")

    with open(f"{OUT}/classical_baseline.json", "w") as f:
        json.dump({"median_err_pct": float(np.median(err)), "max_err_pct": float(np.max(err)),
                   "classification_acc_pct": float(acc * 100), "n_test": len(err)}, f, indent=2)


