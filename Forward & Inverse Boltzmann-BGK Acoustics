def run_forward_main():
    import json, os, time

    OUT = "outputs"
    os.makedirs(OUT, exist_ok=True)

    Kn_list = [1e-3, 1e-2, 1e-1, 1.0]
    results = {"linear": {}, "nonlinear": {}}

    t0 = time.time()
    for regime, eps in [("linear", 1e-3), ("nonlinear", 3e-1)]:
        for Kn in Kn_list:
            d = run_bgk_acoustic(Kn=Kn, eps=eps, NX=128, Nvel=48, T_final=1.0, CFL=0.4)
            results[regime][Kn] = d
            print(f"[forward] {regime} Kn={Kn} done, t={time.time()-t0:.1f}s")

    # ---------------- damping-rate / phase-speed analysis ----------------
    def mode_amplitude(d, k_index=None):
        U = d["u"]  # (Nt, NX)
        if k_index is None:
            k_index = int(round(d["k_wave"] / (2 * np.pi)))
        Uk = np.fft.rfft(U, axis=1)
        amp = np.abs(Uk[:, k_index]) * 2 / U.shape[1]
        phase = np.angle(Uk[:, k_index])
        return d["t"], amp, phase

    fig, axes = plt.subplots(1, 2, figsize=(11, 4))
    damping_table = {"linear": {}, "nonlinear": {}}
    for regime in ["linear", "nonlinear"]:
        for Kn in Kn_list:
            t, amp, phase = mode_amplitude(results[regime][Kn])
            axes[0 if regime == "linear" else 1].plot(t, amp, label=f"Kn={Kn:g}")
            mask = amp > 1e-8
            if mask.sum() > 5:
                coef = np.polyfit(t[mask], np.log(amp[mask] + 1e-12), 1)
                damping_table[regime][Kn] = float(-coef[0])
            else:
                damping_table[regime][Kn] = None
    for ax, title in zip(axes, ["Linear acoustic wave", "Nonlinear acoustic wave"]):
        ax.set_xlabel("t"); ax.set_ylabel("|u_k| (fundamental mode)")
        ax.set_title(title); ax.legend(fontsize=8); ax.grid(True)
    plt.tight_layout()
    plt.savefig(f"{OUT}/forward_mode_damping.png", dpi=150)
    plt.close()

    with open(f"{OUT}/damping_rates.json", "w") as f:
        json.dump(damping_table, f, indent=2)
    print("damping rates:", damping_table)

    # ---------------- snapshot field plots across Kn ----------------
    for regime in ["linear", "nonlinear"]:
        fig, axes = plt.subplots(1, len(Kn_list), figsize=(4 * len(Kn_list), 3.2), sharey=True)
        for ax, Kn in zip(axes, Kn_list):
            d = results[regime][Kn]
            it = min(int(0.12 * len(d["t"])), len(d["t"]) - 1)
            ax.plot(d["x"], d["p"][0], "k--", lw=1, label="t=0")
            ax.plot(d["x"], d["p"][it], "b-", lw=2, label=f"t={d['t'][it]:.2f}")
            ax.set_title(f"Kn={Kn:g}"); ax.set_xlabel("x"); ax.grid(True)
        axes[0].set_ylabel("p(x,t)")
        axes[0].legend(fontsize=8)
        plt.suptitle(f"DVM-BGK acoustic pressure field — {regime} regime")
        plt.tight_layout()
        plt.savefig(f"{OUT}/forward_pressure_{regime}.png", dpi=150)
        plt.close()

    # ---------------- space-time contour (representative case) ----------------
    for regime, Kn_show in [("linear", 1e-2), ("nonlinear", 1e-1)]:
        d = results[regime][Kn_show]
        plt.figure(figsize=(6, 3.2))
        cf = plt.contourf(d["x"], d["t"], d["u"], levels=50, cmap="seismic")
        plt.colorbar(cf, label="u(x,t)")
        plt.xlabel("x"); plt.ylabel("t")
        plt.title(f"Velocity field, {regime} regime, Kn={Kn_show:g}")
        plt.tight_layout()
        plt.savefig(f"{OUT}/forward_contour_{regime}.png", dpi=150)
        plt.close()

    # ================================================================
    # Diagnosing the forward-surrogate mismatch (Sec. 4.3 of the paper).
    #
    # A coordinate network trained on raw (x,t) -> (rho,u,p) undersamples the
    # fast early-time transient and fights spectral bias against k=8*pi; the
    # periodic domain + single-wavenumber IC instead admit a MODAL
    # (spectral-in-space) representation, in which the problem collapses to a
    # smooth, non-oscillatory-in-space regression of a handful of
    # TIME-DEPENDENT harmonic coefficients -- see spectral.py. We first
    # quantify how much of each regime's field this ansatz captures, then
    # compare four architectures on the resulting (much better posed)
    # regression task.
    # ================================================================
    residual_table = {}
    for regime, eps, H in [("linear", 1e-3, 1), ("nonlinear", 3e-1, 6)]:
        d = results[regime][1e-2] if regime == "linear" else results[regime][1e-1]
        Kn_ref = 1e-2 if regime == "linear" else 1e-1
        r_rho, _, _ = projection_residual(d["x"], d["rho"] - 1.0, d["k_wave"], H)
        r_u, _, _ = projection_residual(d["x"], d["u"], d["k_wave"], H)
        r_p, _, _ = projection_residual(d["x"], d["p"] - 1.0, d["k_wave"], H)
        residual_table[regime] = {"Kn_ref": Kn_ref, "n_harmonics": H,
                                   "residual_rho": r_rho, "residual_u": r_u, "residual_p": r_p}
        print(f"[spectral ansatz] {regime} (Kn={Kn_ref:g}, H={H}): "
              f"residual rho={r_rho:.4f}, u={r_u:.4f}, p={r_p:.4f}")
    with open(f"{OUT}/spectral_residuals.json", "w") as f:
        json.dump(residual_table, f, indent=2)

    # ================================================================
    # Architecture comparison on the (corrected) modal-coefficient regression
    # task: Chebyshev-KAN (this paper), tanh-MLP PINN (Raissi et al. 2019),
    # SIREN (Sitzmann et al. 2020), and B-spline KAN (original KAN
    # parameterization, Liu et al. 2024) -- all trained with an identical
    # Adam recipe on the SAME dense (t -> harmonic-coefficient) targets, for
    # the representative linear case Kn=1e-2.
    # ================================================================
    Kn_train = 1e-2
    d_train = results["linear"][Kn_train]
    H_train = 1
    Tin, Y, meta = build_modal_targets(d_train, d_train["k_wave"], n_harmonics=H_train)
    n_out = meta["n_cols"] * 3
    print(f"forward modal-regression target shape: Tin{Tin.shape}, Y{Y.shape} "
          f"(residuals rho={meta['residual_rho']:.4f}, u={meta['residual_u']:.4f}, p={meta['residual_p']:.4f})")

    arch_configs = {
        "chebykan":    dict(layer_sizes=[1, 16, 16, n_out], kwargs=dict(order=8), lr=1e-3, epochs=2000),
        "mlp_pinn":    dict(layer_sizes=[1, 32, 32, n_out], kwargs=dict(), lr=5e-2, epochs=2000),
        "siren":       dict(layer_sizes=[1, 32, 32, n_out], kwargs=dict(omega_0=50.0), lr=1e-3, epochs=1500),
        "bspline_kan": dict(layer_sizes=[1, 16, 16, n_out], kwargs=dict(), lr=2e-3, epochs=1000),
        "sinekan":     dict(layer_sizes=[1, 16, 16, n_out], kwargs=dict(order=6, omega_0=150.0), lr=5e-3, epochs=1500),
        "waveletkan":  dict(layer_sizes=[1, 16, 16, n_out],
                             kwargs=dict(n_scales=6, n_translations=10, w0=20.0, base_scale=0.05), lr=2e-3, epochs=1000),
        "wpinn":       dict(layer_sizes=[1, 32, 32, n_out],
                             kwargs=dict(n_scales=6, n_translations=10, w0=20.0, base_scale=0.05), lr=3e-2, epochs=2000),
        "hwfkan":      dict(layer_sizes=[1, 16, 16, n_out],
                             kwargs=dict(n_harmonics=4, omega_0=150.0, n_scales=4, n_translations=6, w0=20.0, base_scale=0.05),
                             lr=2e-3, epochs=1000),
        "hwfpinn":     dict(layer_sizes=[1, 32, 32, n_out],
                             kwargs=dict(n_harmonics=4, omega_0=150.0, n_scales=4, n_translations=6, w0=20.0, base_scale=0.05),
                             lr=5e-2, epochs=2000),
    }
    DISPLAY_NAMES = {"chebykan": "Chebyshev-KAN", "mlp_pinn": "tanh-MLP (PINN)",
                      "siren": "SIREN", "bspline_kan": "B-spline KAN", "sinekan": "SineKAN",
                      "waveletkan": "Wavelet-KAN", "wpinn": "Wavelet-PINN",
                      "hwfkan": "HWF-KAN", "hwfpinn": "HWF-PINN"}

    arch_results = {}
    def _flatten(params):
        return jax.tree_util.tree_leaves(params)

    for arch_name, cfg in arch_configs.items():
        key = random.PRNGKey(3)
        t0a = time.time()
        params, hist, apply_fn = fit_generic(arch_name, key, cfg["layer_sizes"], Tin, Y,
                                              lr=cfg["lr"], epochs=cfg["epochs"],
                                              weight_decay=1e-8, arch_kwargs=cfg["kwargs"],
                                              verbose=True, tag="forward")
        train_time = time.time() - t0a
        pred_Y = np.asarray(apply_fn(params, jnp.asarray(Tin)))
        rho_p, u_p, p_p = coefs_to_fields(pred_Y, d_train["x"], d_train["k_wave"], H_train)
        rmse_u = float(np.sqrt(np.mean((u_p - d_train["u"]) ** 2)))
        rmse_rho = float(np.sqrt(np.mean((rho_p - d_train["rho"]) ** 2)))
        rmse_p = float(np.sqrt(np.mean((p_p - d_train["p"]) ** 2)))
        n_params = sum(np.asarray(leaf).size for leaf in _flatten(params))
        arch_results[arch_name] = {
            "display_name": DISPLAY_NAMES[arch_name], "rmse_u": rmse_u,
            "rmse_u_normalized": rmse_u / 1e-3, "rmse_rho": rmse_rho, "rmse_p": rmse_p,
            "n_params": int(n_params), "train_time_s": train_time,
            "min_train_loss": min(hist), "u_pred": u_p, "hist": hist,
        }
        print(f"  {DISPLAY_NAMES[arch_name]}: RMSE(u)={rmse_u:.3e} "
              f"(normalized {rmse_u/1e-3:.4f}), params={n_params}, time={train_time:.1f}s")


    best_arch = min(arch_results, key=lambda k: arch_results[k]["rmse_u"])
    print(f"Best architecture by RMSE(u): {DISPLAY_NAMES[best_arch]}")

    # ---- loss curves ----
    plt.figure(figsize=(5, 3.8))
    for arch_name, r in arch_results.items():
        plt.semilogy(r["hist"], label=r["display_name"])
    plt.xlabel("epoch"); plt.ylabel("training MSE (modal-coefficient units)")
    plt.title(f"Forward surrogate training (spectral ansatz), Kn={Kn_train:g}, linear")
    plt.legend(fontsize=8); plt.grid(True)
    plt.tight_layout()
    plt.savefig(f"{OUT}/forward_pikan_loss.png", dpi=150)
    plt.close()

    # ---- best-architecture fit plot, several time snapshots ----
    snap_its = [2, int(0.08 * len(d_train["t"])), int(0.2 * len(d_train["t"])), int(0.4 * len(d_train["t"]))]
    fig, axes = plt.subplots(1, len(snap_its), figsize=(4 * len(snap_its), 3.2), sharey=True)
    u_best = arch_results[best_arch]["u_pred"]
    for ax, it_s in zip(axes, snap_its):
        ax.plot(d_train["x"], d_train["u"][it_s], "k-", lw=2, label="DVM-BGK")
        ax.plot(d_train["x"], u_best[it_s], "r--", lw=2, label=DISPLAY_NAMES[best_arch])
        ax.set_title(f"t={d_train['t'][it_s]:.3f}")
        ax.set_xlabel("x"); ax.grid(True)
    axes[0].set_ylabel("u(x,t)"); axes[0].legend(fontsize=8)
    plt.suptitle(f"Forward surrogate vs DVM-BGK, Kn={Kn_train:g} ({DISPLAY_NAMES[best_arch]}, spectral ansatz)")
    plt.tight_layout()
    plt.savefig(f"{OUT}/forward_pikan_fit.png", dpi=150)
    plt.close()

    # ---- architecture-comparison figure (single representative snapshot) ----
    it_show = snap_its[1]
    n_arch = len(arch_configs)
    ncols = 3
    nrows = int(np.ceil(n_arch / ncols))
    fig, axes = plt.subplots(nrows, ncols, figsize=(4.0 * ncols, 3.2 * nrows), sharey=True)
    axes_flat = np.atleast_1d(axes).ravel()
    for ax, arch_name in zip(axes_flat, arch_configs.keys()):
        r = arch_results[arch_name]
        ax.plot(d_train["x"], d_train["u"][it_show], "k-", lw=2, label="DVM-BGK")
