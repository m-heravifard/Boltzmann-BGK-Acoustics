def extract_features_windowed(t, series_dict, n_windows=4, keys=("p", "u")):
    """
    series_dict: {key: (Nt,Ns) array, ...} sparse-sensor time series for each
    requested observable `keys` (e.g. "p","u","rho","T","q").
    Returns a fixed-length feature vector summarizing, for each key:
      - envelope decay rate (log-RMS slope across n_windows time windows)
      - RMS amplitude ratio last-window/first-window
      - log initial RMS amplitude
    plus the zero-crossing frequency of the FIRST key only (a frequency
    estimate does not need to be repeated per-observable).
    Robust to noise and to having very few sensors (averages across sensors).
    """
    Nt = len(t)
    edges = np.linspace(0, Nt, n_windows + 1).astype(int)

    def window_rms(x):
        # x: (Nt, Ns) -> rms per window per sensor, then mean over sensors -> (n_windows,)
        vals = []
        for w in range(n_windows):
            seg = x[edges[w]:edges[w + 1], :]
            vals.append(np.sqrt(np.mean(seg ** 2) + 1e-14))
        return np.array(vals)

    feats = []
    for key in keys:
        x = series_dict[key]
        x = x - x.mean(axis=0, keepdims=True)
        rms = window_rms(x)
        tw = 0.5 * (t[edges[:-1]] + t[edges[1:] - 1])
        logrms = np.log(rms + 1e-14)
        slope = np.polyfit(tw, logrms, 1)[0]
        feats.append(-slope)                          # decay rate (positive)
        feats.append(np.log((rms[-1] + 1e-14) / (rms[0] + 1e-14)))  # log amplitude ratio
        feats.append(np.log(rms[0] + 1e-14))           # initial amplitude (disambiguates linear/nonlinear)

    # dominant frequency from zero crossings of the first requested key,
    # averaged across sensors
    ref = series_dict[keys[0]]
    freqs = []
    for s in range(ref.shape[1]):
        sgn = np.sign(ref[:, s] - ref[:, s].mean())
        crossings = np.sum(np.abs(np.diff(sgn)) > 0)
        freqs.append(crossings / (2 * (t[-1] - t[0]) + 1e-12))
    feats.append(np.mean(freqs))

    return np.array(feats)  # [decay,ratio,logamp0]*len(keys) + [freq]


FEATURE_NAMES = ["decay_p", "log_ratio_p", "log_amp0_p", "decay_u", "log_ratio_u", "log_amp0_u", "zero_cross_freq"]


# ============================================================================
# Parametric (damped-sinusoid fit) features -- a higher-fidelity alternative
# to the crude windowed-RMS features above, added after empirically finding
# that the windowed-RMS features were the main accuracy bottleneck for
# Kn-identification, not the choice of regressor architecture (see paper
# Sec. 5.2). Each sensor's p(t)/u(t) is fit directly to a damped sinusoid
# a*exp(-g t)*cos(w t + phi) via nonlinear least squares, giving much
# cleaner, less noisy (amplitude, decay-rate, frequency) estimates than a
# 4-window log-RMS slope.
# ============================================================================


def _damped_sinusoid(t, a, g, w, phi):
    return a * np.exp(-g * t) * np.cos(w * t + phi)


def _crude_estimates(t, y):
    """Cheap initial guess for the nonlinear fit below (the old windowed-RMS
    method, used here only as a warm start, not as the reported feature)."""
    n_windows = 4
    Nt = len(t)
    edges = np.linspace(0, Nt, n_windows + 1).astype(int)
    rms = np.array([np.sqrt(np.mean(y[edges[w]:edges[w + 1]] ** 2) + 1e-14)
                     for w in range(n_windows)])
    tw = 0.5 * (t[edges[:-1]] + t[edges[1:] - 1])
    g0 = max(-np.polyfit(tw, np.log(rms + 1e-14), 1)[0], 1e-3)
    sgn = np.sign(y - y.mean())
    crossings = np.sum(np.abs(np.diff(sgn)) > 0)
    w0 = 2 * np.pi * crossings / (2 * (t[-1] - t[0]) + 1e-12)
    a0 = np.abs(y).max() + 1e-12
    return a0, g0, max(w0, 1e-2)


def _fit_one(t, y):
    """Nonlinear least-squares fit of a single sensor's time series to a
    damped sinusoid, multi-started over a few phase seeds (the cosine model
    is periodic and prone to local minima if the initial phase/frequency
    guess is off by half a cycle). Falls back to the cheap estimate if the
    fit does not converge for any seed."""
    y = y - y.mean()
    a0, g0, w0 = _crude_estimates(t, y)
    best = None
    for phi0 in (0.0, np.pi / 2, np.pi, -np.pi / 2):
        try:
            popt, _ = curve_fit(_damped_sinusoid, t, y, p0=[a0, g0, w0, phi0],
                                 maxfev=20000,
                                 bounds=([0, 1e-6, 1e-3, -10 * np.pi],
                                         [10 * a0, 1e4, 1e4, 10 * np.pi]))
            resid = np.sqrt(np.mean((y - _damped_sinusoid(t, *popt)) ** 2))
            if best is None or resid < best[0]:
                best = (resid, popt)
        except Exception:
            continue
    if best is None:
        return a0, g0, w0, 0.0, False
    _, (a, g, w, phi) = best
    return abs(a), g, abs(w), phi, True


def extract_features_parametric(t, series_dict, keys=("p", "u")):
    """Fit each sensor's signal (for each requested observable `keys`) to a
    damped sinusoid a*exp(-g t)*cos(w t + phi); average the resulting
    (log a, g, w) across sensors (phase is sensor-position-dependent and not
    averaged), plus one convergence-fraction diagnostic covering all keys."""
    feats = []
    n_ok_total = 0
    n_total = 0
    for key in keys:
        x = series_dict[key]
        Ns = x.shape[1]
        A, G, W = [], [], []
        n_ok = 0
        for s in range(Ns):
            a, g, w, phi, ok = _fit_one(t, x[:, s])
            A.append(a); G.append(g); W.append(w)
            n_ok += int(ok)
        n_ok_total += n_ok
        n_total += Ns
        feats.append(np.log(np.mean(A) + 1e-14))
        feats.append(np.mean(G))
        feats.append(np.mean(W))
    feats.append(n_ok_total / n_total)
    return np.array(feats)


def parametric_feature_names(keys=("p", "u")):
    names = []
    for key in keys:
        names += [f"log_amp_{key}", f"decay_{key}_param", f"freq_{key}_param"]
    names.append("fit_ok_frac")
    return names


PARAMETRIC_FEATURE_NAMES = parametric_feature_names(("p", "u"))


def feature_names(keys=("p", "u"), n_windows=4):
    names = []
    for key in keys:
        names += [f"decay_{key}", f"log_ratio_{key}", f"log_amp0_{key}"]
    names.append("zero_cross_freq")
    return names


def extract_features_combined(t, series_dict, n_windows=4, keys=("p", "u")):
    """Concatenation of the windowed-RMS features (robust, coarse) and the
    parametric damped-sinusoid features (precise, occasionally brittle for
    pathological signals), for each requested observable `keys`. Empirically
    the best feature set tested for Kn identification from {p,u} alone
    (paper Sec. 5.2): combining a robust-but-coarse estimator with a
    precise-but-occasionally-brittle one gives both a better median AND a
    better worst-case error than either alone. `keys` can be extended beyond
    {p,u} to include density, temperature, and/or heat flux (Sec.~5.7's
    multi-observable information hierarchy)."""
    return np.concatenate([extract_features_windowed(t, series_dict, n_windows=n_windows, keys=keys),
                            extract_features_parametric(t, series_dict, keys=keys)])


def combined_feature_names(keys=("p", "u"), n_windows=4):
    return feature_names(keys, n_windows) + parametric_feature_names(keys)


COMBINED_FEATURE_NAMES = combined_feature_names(("p", "u"))


