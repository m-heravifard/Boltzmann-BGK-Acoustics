def run_independent_test_set_main():
    extract_features = extract_features_combined

    # Freeze the pipeline: train ONCE on the full standard calibration grid
    # (all 34 Kn values, no held-out split), exactly as the deployed model would
    # be. Architecture, features, and hyperparameters are fixed BEFORE this
    # independent test set is generated.
    Kn_calib = np.geomspace(3e-4, 3.0, 34)
    Xall, Yall, meta = build_calibration_dataset(Kn_calib, regimes=("linear",), n_sensor_draws=5)
    mu, sd = Xall.mean(0, keepdims=True), Xall.std(0, keepdims=True) + 1e-8
    net_inv, _, hist, _, apply_fn = train_inverse_map(Xall, Yall, Xall[:1], hidden=16, omega_0=1.0,
                                                        epochs=4000, lr=3e-3, weight_decay=1e-3, seed=42)

    # Independent test set: 15 Kn values drawn uniformly at random in log-space
    # over the SAME overall range, generated with a seed never used above, and
    # with a completely fresh set of random sensor placements (new RNG stream).
    # None of these Kn values coincide with the calibration grid.
    rng_indep = np.random.default_rng(999)
    Kn_independent = 10 ** rng_indep.uniform(np.log10(3e-4), np.log10(3.0), size=15)
    Kn_independent = np.sort(Kn_independent)
    print("Independent test Kn values:", np.round(Kn_independent, 5).tolist())

    Kn_true_list, Kn_pred_list = [], []
    for Kn in Kn_independent:
        d = run_bgk_acoustic(Kn=Kn, eps=1e-3, NX=64, Nvel=32, T_final=0.6, CFL=0.4)
        NXg = len(d["x"])
        idx = np.sort(rng_indep.choice(np.arange(4, NXg - 4), size=N_SENSORS, replace=False))
        sens = sample_sensors(d, idx, field_names=("p", "u"))
        feats = extract_features(sens["t"], sens).reshape(1, -1)
        feats_n = (feats - mu) / sd
        pred = float(np.asarray(apply_fn(net_inv, jnp.asarray(feats_n))).squeeze())
        Kn_true_list.append(Kn)
        Kn_pred_list.append(10 ** pred)

    Kn_true = np.array(Kn_true_list)
    Kn_pred = np.array(Kn_pred_list)
    err = np.abs(Kn_pred - Kn_true) / Kn_true * 100
    acc, conf = classification_accuracy(Kn_true, Kn_pred)
    print(f"Independent test set: median={np.median(err):.2f}% max={np.max(err):.1f}% "
          f"classification_acc={acc*100:.1f}% n={len(err)}")
    for kt, kp, e in zip(Kn_true, Kn_pred, err):
        print(f"  true={kt:.5f}  pred={kp:.5f}  err={e:.1f}%")

    with open(f"{OUT}/independent_test_set.json", "w") as f:
        json.dump({"Kn_true": Kn_true.tolist(), "Kn_pred": Kn_pred.tolist(), "err_pct": err.tolist(),
                   "median_err_pct": float(np.median(err)), "max_err_pct": float(np.max(err)),
                   "classification_acc_pct": float(acc * 100)}, f, indent=2)


