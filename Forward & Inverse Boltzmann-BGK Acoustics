"""
Advanced extension: Kn(x), tau(x) field identification. (JAX autodiff.)

Reuses the scalar inverse-map R_phi (Sec. 5 / inverse_pikan.py, a SIREN --
see inverse_pikan.train_inverse_map's docstring for the two-round
7-architecture comparison, including a data-leakage bug found and fixed
along the way, that confirmed SIREN as the right choice), applying it
LOCALLY at each of several sparse sensor locations distributed across the
domain (assuming Kn(x) varies slowly on the scale of one acoustic
wavelength, so each sensor "sees" an approximately locally-homogeneous
relaxation time -- a standard quasi-homogeneous/eikonal-type approximation).

The resulting noisy, pointwise log10(Kn) estimates are then fit with a
small 1D SIREN g(x) -> log10 Kn(x) -- again SIREN, per the Sec. 4.3
architecture comparison, since this second step is a genuinely different
task (a smooth spatial coordinate regression, not a feature-vector
regression) and one of the test profiles (the smooth sinusoidal Kn(x)
case) is itself oscillatory. This gives a smooth reconstructed field that
can be compared directly against the ground-truth Kn(x) profile used to
drive the (spatially-varying-relaxation-time) DVM-BGK solver.
"""
import json, time
extract_features = extract_features_combined

SCALAR_MAP_OMEGA0 = 1.0  # must match the omega_0 used to train net_inv below

SIREN_OMEGA0_FIELD = 1.0  # re-tuned (see run_field_case docstring / paper Sec. 6):
                          # denser sensor grids need a LOWER omega_0 (smoother
                          # SIREN basis) and stronger weight decay, or the
                          # field-fit overfits the increased number of noisy
                          # pointwise estimates instead of smoothing through them.


def true_Kn_profiles():
    def step(x):
        return 3e-3 + 0.2 * (0.5 * (1 + np.tanh((x - 0.5) / 0.04)))

    def smooth(x):
        return 10 ** (-2.5 + 1.5 * np.sin(2 * np.pi * x))

    return {"step_interface": step, "smooth_sinusoidal": smooth}


def fit_1d_field(x_sensor, y_target, hidden=8, epochs=2500, lr=2e-3,
                  weight_decay=1e-2, seed=0, omega_0=SIREN_OMEGA0_FIELD):
    init_fn, apply_raw = ARCHS["siren"]
    apply_fn = lambda p, xx: apply_raw(p, xx, omega_0=omega_0)
    key = random.PRNGKey(seed)
    params = init_fn(key, [1, hidden, hidden, 1], omega_0=omega_0)
    optimizer = optax.adam(lr)
    opt_state = optimizer.init(params)
    Xs = jnp.asarray(x_sensor.reshape(-1, 1))
    Ys = jnp.asarray(y_target.reshape(-1, 1))

    def loss_fn(p):
        pred = apply_fn(p, Xs)
        l2 = sum(jnp.mean(c ** 2) for c in jax.tree_util.tree_leaves(p))
        return jnp.mean((pred - Ys) ** 2) + weight_decay * l2

    def step(params, opt_state):
        loss, grads = jax.value_and_grad(loss_fn)(params)
        updates, opt_state = optimizer.update(grads, opt_state, params)
        params = optax.apply_updates(params, updates)
        return params, opt_state, loss
    step = jax.jit(step)

    hist, best_loss, best_params = [], float("inf"), params
    for ep in range(epochs):
        params, opt_state, loss = step(params, opt_state)
        loss_f = float(loss)
        hist.append(loss_f)
        if loss_f < best_loss:
            best_loss, best_params = loss_f, params
    return best_params, hist, apply_fn


def run_field_case(Kn_fn, name, net_inv, mu, sd, n_sensors=12, seed=0, n_epochs=2500):
    """n_sensors=12 (up from an initial 8) with re-tuned field-fit
    hyperparameters (fit_1d_field's new defaults: hidden=8, omega_0=1.0,
    weight_decay=1e-2) was chosen after a direct sweep (paper Sec. 6):
    naively increasing sensor count with the OLD hyperparameters (hidden=16,
    omega_0=8, weight_decay=1e-4) made results WORSE, not better -- more
    noisy pointwise estimates gave the flexible SIREN interpolant enough
    points to wiggle through all of them, producing wild spurious
    oscillations between sensors instead of a smoother, more accurate
    reconstruction. Once the field-fit network's capacity/frequency content
    was reduced to match the increased point density, n_sensors=12
    (verified stable across several seeds) gives a clear net improvement
    over the original 8-sensor result, especially for the smooth sinusoidal
    Kn(x) profile."""
    d = run_bgk_acoustic(Kn=Kn_fn, eps=1e-3, NX=128, Nvel=40, T_final=0.6, CFL=0.4)
    NX = len(d["x"])
    # evenly spaced (not random) sensors so the whole domain is probed
    idx = np.linspace(6, NX - 6, n_sensors).astype(int)
    x_sensor = d["x"][idx]

    # local pointwise Kn estimate at each sensor using the (single-sensor)
    # feature extractor + the pretrained global inverse-map
    Kn_point_est = []
    for i in idx:
        sens = {"t": d["t"], "p": d["p"][:, i:i + 1], "u": d["u"][:, i:i + 1]}
        feats = extract_features(sens["t"], sens).reshape(1, -1)
        feats_n = (feats - mu) / sd
        pred = np.asarray(ARCHS["siren"][1](net_inv, jnp.asarray(feats_n), omega_0=SCALAR_MAP_OMEGA0))
        Kn_point_est.append(10 ** pred.item())
    Kn_point_est = np.array(Kn_point_est)

    # fit a small 1D SIREN field g(x) -> log10 Kn(x) to the noisy pointwise
    # estimates -- SIREN, the architecture that won the Sec. 4.3 comparison,
    # not Chebyshev-KAN; hyperparameters use fit_1d_field's re-tuned
    # defaults (see docstring above)
    field_params, _, field_apply_fn = fit_1d_field(x_sensor, np.log10(Kn_point_est),
                                                     epochs=n_epochs, seed=seed + 20)

    x_dense = np.linspace(0, d["x"][-1], 200).reshape(-1, 1)
    Kn_field_pred = 10 ** np.asarray(field_apply_fn(field_params, jnp.asarray(x_dense))).squeeze()
    Kn_field_true = Kn_fn(x_dense.squeeze())

    rel_err = np.abs(np.log10(Kn_field_pred) - np.log10(Kn_field_true))
    result = {
        "name": name, "x_sensor": x_sensor.tolist(), "Kn_point_est": Kn_point_est.tolist(),
        "x_dense": x_dense.squeeze().tolist(), "Kn_field_pred": Kn_field_pred.tolist(),
        "Kn_field_true": Kn_field_true.tolist(),
        "mean_abs_log10_err": float(rel_err.mean()), "max_abs_log10_err": float(rel_err.max()),
    }
    return result


def run_inverse_field_main():
    t0 = time.time()
    print("Training global scalar inverse-map (reused for local pointwise estimates)...")
    Kn_calib = np.geomspace(3e-4, 3.0, 26)
    Xall, Yall, meta = build_calibration_dataset(Kn_calib, regimes=("linear",), n_sensor_draws=3)
    net_inv, (mu, sd), _, _, _ = train_inverse_map(Xall, Yall, Xall[:1], hidden=16, omega_0=1.0,
                                                 epochs=4000, lr=3e-3, weight_decay=1e-3, seed=7)
    print(f"global inverse-map trained, t={time.time()-t0:.1f}s")

    results = {}
    for name, fn in true_Kn_profiles().items():
        print(f"Field case: {name}")
        results[name] = run_field_case(fn, name, net_inv, mu, sd, seed=0)
        print(f"  mean |log10 err| = {results[name]['mean_abs_log10_err']:.3f} dex, "
              f"t={time.time()-t0:.1f}s")

    fig, axes = plt.subplots(1, 2, figsize=(10, 4))
    for ax, (name, r) in zip(axes, results.items()):
        ax.plot(r["x_dense"], r["Kn_field_true"], "k-", lw=2, label="true Kn(x)")
        ax.plot(r["x_dense"], r["Kn_field_pred"], "r--", lw=2, label="SIREN Kn(x)")
        ax.plot(r["x_sensor"], r["Kn_point_est"], "bo", ms=6, label="pointwise sensor estimate")
        ax.set_yscale("log")
        ax.set_xlabel("x"); ax.set_ylabel("Kn(x)")
        ax.set_title(name.replace("_", " "))
        ax.legend(fontsize=7); ax.grid(True, which="both", alpha=0.4)
    plt.tight_layout()
    plt.savefig(f"{OUT}/inverse_field_Kn_x.png", dpi=150)
    plt.close()

    with open(f"{OUT}/inverse_field_summary.json", "w") as f:
        json.dump({k: {"mean_abs_log10_err": v["mean_abs_log10_err"],
                        "max_abs_log10_err": v["max_abs_log10_err"]} for k, v in results.items()},
                  f, indent=2)
    print("Field-extension study complete. total time", time.time() - t0)


