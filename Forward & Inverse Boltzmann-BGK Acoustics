# ============================================================================
"""
Spectral (modal) representation for the periodic acoustic-wave problem.

Diagnosis (see paper Sec. 4.3): a coordinate network trained to map raw
(x, t) directly onto the macroscopic field (rho, u, p) suffers from two
compounding problems for this benchmark -- (a) spectral bias against the
imposed wavenumber k=8*pi, and (b) severe imbalance in how informative
different training-time samples are, since the acoustic signal decays by
1-2 orders of magnitude within the first ~20% of the simulated window, so
uniform random (x,t) collocation sampling wastes most of its budget on
the already-decayed tail.

The periodic domain and single-wavenumber initial condition make this
problem naturally suited to a MODAL (spectral-in-space) representation
instead: for x in [0, L) periodic with imposed wavenumber k, project the
field onto a constant offset plus sin(n k x), cos(n k x) for harmonics
n=1..H. The constant-offset term matters: a finite-amplitude initial
condition rho=rho0+eps*sin(kx), u=eps*sin(kx) gives rho*u a nonzero
spatial mean (eps^2/2) at O(eps^2), which the BGK collision operator then
conserves exactly for all time (verified numerically below); omitting a
DC term from the basis makes the projection look artificially bad in the
nonlinear regime even though it has nothing to do with harmonic content.
In the linear-acoustics regime, a single harmonic (plus offset) already
captures the field to within a fraction of a percent (`projection_residual`
below); the residual remains non-trivial in the nonlinear regime even
with many harmonics -- genuine broadband content from wave steepening,
reported honestly rather than concealed (see paper Sec. 4.3/7).

Once the field is projected, EVERY spatial degree of freedom collapses
into a handful of TIME-DEPENDENT coefficients per macroscopic variable --
an ordinary, non-oscillatory-in-space, 1-D regression problem that any of
the architectures in architectures.py can fit well with dense supervision
(every simulated time step is one exact training point; no random
collocation sampling is needed).
"""


def n_cols(n_harmonics, include_offset=True):
    return (1 if include_offset else 0) + 2 * n_harmonics


def basis_matrix(x, k, n_harmonics=1, include_offset=True):
    """x: (NX,). Returns (NX, n_cols) matrix of
    [1 (optional), sin(kx), cos(kx), sin(2kx), cos(2kx), ...]."""
    cols = []
    if include_offset:
        cols.append(np.ones_like(x))
    for n in range(1, n_harmonics + 1):
        cols.append(np.sin(n * k * x))
        cols.append(np.cos(n * k * x))
    return np.stack(cols, axis=1)


def project_modes(x, field_snapshots, k, n_harmonics=1, include_offset=True):
    """field_snapshots: (NT, NX). Returns modal coefficients (NT, n_cols)
    via least-squares projection onto the basis at each time."""
    B = basis_matrix(x, k, n_harmonics, include_offset)
    coefs, *_ = np.linalg.lstsq(B, field_snapshots.T, rcond=None)
    return coefs.T


def reconstruct_from_modes(coefs, x, k, n_harmonics=1, include_offset=True):
    """coefs: (NT, n_cols). Returns (NT, NX)."""
    B = basis_matrix(x, k, n_harmonics, include_offset)
    return coefs @ B.T


def reconstruct_from_modes_jax(coefs, x, k, n_harmonics=1, include_offset=True):
    """Same as above but differentiable / jnp-native, coefs: (...,n_cols)."""
    cols = []
    if include_offset:
        cols.append(jnp.ones_like(x))
    for n in range(1, n_harmonics + 1):
        cols.append(jnp.sin(n * k * x))
        cols.append(jnp.cos(n * k * x))
    B = jnp.stack(cols, axis=1)
    return coefs @ B.T


def projection_residual(x, field_snapshots, k, n_harmonics=1, include_offset=True):
    """RMS(residual)/RMS(field) -- used to justify (or flag the breakdown
    of) the modal ansatz for a given regime."""
    coefs = project_modes(x, field_snapshots, k, n_harmonics, include_offset)
    recon = reconstruct_from_modes(coefs, x, k, n_harmonics, include_offset)
    resid = field_snapshots - recon
    denom = np.sqrt(np.mean(field_snapshots ** 2)) + 1e-30
    return float(np.sqrt(np.mean(resid ** 2)) / denom), coefs, recon


def build_modal_targets(d, k, n_harmonics=1, rho0=1.0, p0=1.0, include_offset=True):
    """Given a bgk_acoustic.run_bgk_acoustic() result dict, project
    (rho-rho0, u, p-p0) onto the basis. Returns:
      Tin  : (NT,1) normalized time in [0,1]
      Y    : (NT, 3*n_cols) stacked [rho_coefs, u_coefs, p_coefs]
      meta : dict with x, k, n_harmonics, t_max, include_offset, residuals
    """
    x = d["x"]; t = d["t"]; t_max = t.max()
    res_rho, c_rho, _ = projection_residual(x, d["rho"] - rho0, k, n_harmonics, include_offset)
    res_u, c_u, _ = projection_residual(x, d["u"], k, n_harmonics, include_offset)
    res_p, c_p, _ = projection_residual(x, d["p"] - p0, k, n_harmonics, include_offset)
    Y = np.concatenate([c_rho, c_u, c_p], axis=1)
    Tin = (t / t_max).reshape(-1, 1)
    meta = {"x": x, "k": k, "n_harmonics": n_harmonics, "t_max": t_max,
            "include_offset": include_offset, "n_cols": n_cols(n_harmonics, include_offset),
            "residual_rho": res_rho, "residual_u": res_u, "residual_p": res_p}
    return Tin, Y, meta


def coefs_to_fields(Y, x, k, n_harmonics, rho0=1.0, p0=1.0, include_offset=True):
    """Inverse of build_modal_targets's stacking: Y (NT,3*n_cols) -> rho,u,p (NT,NX)."""
    nc = n_cols(n_harmonics, include_offset)
    c_rho, c_u, c_p = Y[:, 0:nc], Y[:, nc:2 * nc], Y[:, 2 * nc:3 * nc]
    rho = reconstruct_from_modes(c_rho, x, k, n_harmonics, include_offset) + rho0
    u = reconstruct_from_modes(c_u, x, k, n_harmonics, include_offset)
    p = reconstruct_from_modes(c_p, x, k, n_harmonics, include_offset) + p0
    return rho, u, p


