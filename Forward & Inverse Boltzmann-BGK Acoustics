"""
Reduced (g,h) discrete-velocity-method BGK (DVM-BGK) kinetic solver for the
periodic acoustic-wave benchmark, adapted from the Sod shock-tube solver supplied by the user. Same
discrete-velocity / reduced-distribution formulation, but with:
  * periodic domain and periodic BCs (appropriate for the acoustic wave
    problem instead of the Riemann problem),
  * sinusoidal perturbation initial conditions (linear or nonlinear
    amplitude) about a uniform equilibrium state,
  * a fixed relaxation time tau = Kn (single-Kn BGK model; Kn plays the
    role of the dimensionless mean-free-path / relaxation time used
    throughout the paper).

Used to (1) generate forward "ground truth" fields for the Chebyshev-PIKAN
forward-problem benchmarks, and (2) generate sparse synthetic sensor
measurements {p(t), u(t)} for the inverse-problem (regime identification)
experiments.
"""


def run_bgk_acoustic(Kn, eps=1e-3, NX=128, Nvel=48, T_final=1.0, CFL=0.4,
                      rho0=1.0, u0=0.0, T0=1.0, k_mult=8, save_every=4,
                      x_field_Kn=None):
    """Periodic reduced BGK; stream THEN recompute the collision equilibrium.

    Uses discrete moment-conserving equilibrium correction. This corrects
    the supplied solver's old-state equilibrium (which attenuated streaming
    in the stiff limit), and invalidates reuse of its old accuracy numbers.
    Spatial upwinding is still first order; grid convergence is still needed.
    """
    if NX<8 or Nvel<8 or T_final<=0 or not 0<CFL<=1 or save_every<1:
        raise ValueError('invalid grid, final time, CFL or save interval')
    if rho0<=abs(eps) or rho0*T0<=abs(eps) or k_mult%2:
        raise ValueError('positive initial density/pressure and even k_mult required')
    x=np.arange(NX)/NX; dx=1./NX; k=k_mult*np.pi
    v,w=kinetic_quadrature(Nvel); A,B=kinetic_projection(v,w,np)
    dt0=CFL*dx/np.max(np.abs(v)); nt=int(np.ceil(T_final/dt0)); dt=T_final/nt
    tau=np.broadcast_to(np.asarray(Kn(x) if callable(Kn) else Kn,float),(NX,)).copy()
    if not np.all(np.isfinite(tau)) or np.any(tau<=0): raise ValueError('Kn must be positive')
    rho=rho0+eps*np.sin(k*x); u=u0+eps*np.sin(k*x)
    Ti=(rho0*T0+eps*np.sin(k*x))/rho
    g=rho[:,None]/np.sqrt(2*np.pi*Ti[:,None])*np.exp(-(v-u[:,None])**2/(2*Ti[:,None]))
    h=2*Ti[:,None]*g
    hist={key:[] for key in ['rho','u','p','T','q','Pxx','Pi_xx','momentum_flux']}; times=[]
    minimum_eq=float('inf')
    def save(t):
        m=kinetic_moments(g,h,v,w,np)
        for key in hist: hist[key].append(m[key].copy())
        times.append(t)
    save(0.)
    initial=kinetic_moments(g,h,v,w,np)
    total0=np.array([initial['rho'].sum(),initial['momentum'].sum(),initial['energy'].sum()])*dx
    decay=np.exp(-dt/tau)[:,None]
    for n in range(nt):
        def stream(f):
            derivative=np.where(v[None,:]>=0,(f-np.roll(f,1,axis=0))/dx,
                                 (np.roll(f,-1,axis=0)-f)/dx)
            return f-dt*v*derivative
        gs,hs=stream(g),stream(h)
        ge,he=kinetic_equilibrium(gs,hs,v,w,A,B,np)
        minimum_eq=min(minimum_eq,float(ge.min()),float(he.min()))
        g=ge+(gs-ge)*decay; h=he+(hs-he)*decay
        m=kinetic_moments(g,h,v,w,np)
        if (not np.all(np.isfinite(g)) or not np.all(np.isfinite(h))
                or np.any(m['rho']<=0) or np.any(m['T']<=0)):
            raise FloatingPointError('BGK state invalid; refine grid/check input')
        if min(float(g.min()),float(h.min())) < -1e-12:
            raise FloatingPointError('Conservative equilibrium lost positivity; increase Nvel')
        if (n+1)%save_every==0 or n==nt-1: save((n+1)*dt)
    final=kinetic_moments(g,h,v,w,np)
    total1=np.array([final['rho'].sum(),final['momentum'].sum(),final['energy'].sum()])*dx
    return dict(x=x,t=np.asarray(times),**{key:np.asarray(val) for key,val in hist.items()},
                dt=dt,dx=dx,tau_field=tau,k_wave=k,
                conserved_total_drift=total1-total0,min_corrected_equilibrium=minimum_eq,
                solver_version='post_stream_conservative_BGK_v1')


def sample_sensors(field_dict, x_sensor_idx, field_names=("p", "u")):
    """Extract sparse point-sensor time series at given spatial grid indices."""
    out = {"t": field_dict["t"], "x_sensor": field_dict["x"][x_sensor_idx]}
    for name in field_names:
        out[name] = field_dict[name][:, x_sensor_idx]  # (Nt, Nsensors)
    return out


